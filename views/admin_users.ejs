<%- include('partials/head',{title:'Pengguna'}) %><form class="d-flex gap-2 mb-3"><input class="form-control" name="q" value="<%= qs %>" placeholder="Cari nama/email"><button class="btn btn-outline-primary">Cari</button></form>
<div class="card"><div class="table-responsive"><table class="table mb-0 align-middle"><thead><tr><th>Nama</th><th>Email</th><th>Role</th><th>Tugas</th><th>Aksi</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><%= u.name %></td><td><%= u.email %></td><td><%= u.role %></td><td><%= u.tasks %></td><td class="d-flex gap-1">
<form method="post" action="/admin/users/<%= u.id %>" data-confirm="Ubah status akun?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="toggle"><button class="btn btn-sm btn-outline-<%= u.is_active?'danger':'success' %>"><%= u.is_active?'Nonaktifkan':'Aktifkan' %></button></form>
<form method="post" action="/admin/users/<%= u.id %>" data-confirm="Ubah role pengguna ini?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="role"><input type="hidden" name="role" value="<%= u.role==='admin'?'user':'admin' %>"><button class="btn btn-sm btn-outline-secondary">Jadikan <%= u.role==='admin'?'user':'admin' %></button></form></td></tr><% }) %></tbody></table></div></div><%- include('partials/foot') %>
