
<%- include('partials/head', { title: 'Dashboard' }) %>

<style>
    .dashboard-page {
        --dash-primary: #4f46e5;
        --dash-border: #e9eaf2;
        --dash-muted: #737991;
        color: #20243a;
        animation: dashEnter .55s ease both;
    }

    @keyframes dashEnter {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .dashboard-page .text-muted {
        color: var(--dash-muted) !important;
    }

    .dashboard-page .welcome-panel {
        position: relative;
        overflow: hidden;
        padding: 28px;
        border-radius: 22px;
        color: white;
        background: linear-gradient(120deg, #3730a3, #4f46e5 58%, #818cf8);
        box-shadow: 0 12px 30px rgba(79, 70, 229, .16);
    }

    .welcome-panel::before,
    .welcome-panel::after {
        content: "";
        position: absolute;
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 50%;
        pointer-events: none;
    }

    .welcome-panel::before {
        width: 230px;
        height: 230px;
        right: -55px;
        top: -125px;
    }

    .welcome-panel::after {
        width: 170px;
        height: 170px;
        right: 65px;
        bottom: -125px;
    }

    .welcome-content {
        position: relative;
        z-index: 1;
    }

    .welcome-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 10px;
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 999px;
        background: rgba(255,255,255,.1);
        font-size: .76rem;
    }

    .welcome-title {
        margin: 15px 0 8px;
        font-size: clamp(1.4rem, 3vw, 2rem);
        font-weight: 750;
        letter-spacing: -.7px;
    }

    .welcome-description {
        max-width: 470px;
        color: rgba(255,255,255,.8);
        font-size: .9rem;
        line-height: 1.7;
    }

    .welcome-action {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 16px;
        color: #4338ca;
        background: white;
        border-radius: 11px;
        font-size: .86rem;
        font-weight: 650;
        text-decoration: none;
        transition: .2s ease;
    }

    .welcome-action:hover {
        color: #312e81;
        background: #eef2ff;
        transform: translateY(-2px);
    }

    .section-heading {
        font-size: 1rem;
        font-weight: 750;
        letter-spacing: -.25px;
    }

    .section-caption {
        font-size: .8rem;
        color: var(--dash-muted);
    }

    .dashboard-stat {
        height: 100%;
        padding: 18px;
        background: #fff;
        border: 1px solid var(--dash-border);
        border-radius: 17px;
        transition: transform .22s ease, box-shadow .22s ease,
                    border-color .22s ease;
    }

    .dashboard-stat:hover {
        transform: translateY(-3px);
        border-color: #d9d9fa;
        box-shadow: 0 10px 25px rgba(35, 39, 70, .06);
    }

    .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        border-radius: 13px;
        font-size: 1.15rem;
    }

    .stat-total .stat-icon {
        background: #eef2ff;
        color: #4f46e5;
    }

    .stat-open .stat-icon {
        background: #fff7e6;
        color: #d97706;
    }

    .stat-done .stat-icon {
        background: #e9f9ef;
        color: #159447;
    }

    .stat-soon .stat-icon {
        background: #e8f7ff;
        color: #0284c7;
    }

    .stat-late .stat-icon {
        background: #fff0f0;
        color: #dc2626;
    }

    .stat-label {
        margin-top: 15px;
        color: var(--dash-muted);
        font-size: .79rem;
        font-weight: 550;
    }

    .stat-number {
        margin-top: 3px;
        font-size: 1.85rem;
        font-weight: 780;
        line-height: 1.3;
        letter-spacing: -1px;
    }

    .dashboard-panel {
        overflow: hidden;
        background: white;
        border: 1px solid var(--dash-border);
        border-radius: 18px;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 20px 22px;
        border-bottom: 1px solid #f0f1f6;
    }

    .panel-body {
        padding: 0;
    }

    .task-row {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 17px 22px;
        color: inherit;
        text-decoration: none;
        transition: background .2s ease;
    }

    .task-row + .task-row {
        border-top: 1px solid #f1f2f7;
    }

    .task-row:hover {
        background: #f8f9ff;
    }

    .task-file-icon {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        color: #4f46e5;
        background: #eef2ff;
        border-radius: 12px;
        font-size: 1.05rem;
    }

    .task-main {
        min-width: 0;
        flex: 1;
    }

    .task-title {
        overflow: hidden;
        color: #252942;
        font-size: .9rem;
        font-weight: 650;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .task-subtitle {
        margin-top: 5px;
        color: var(--dash-muted);
        font-size: .76rem;
    }

    .task-deadline {
        flex-shrink: 0;
        padding: 7px 10px;
        color: #596078;
        background: #f5f6fa;
        border-radius: 9px;
        font-size: .75rem;
        white-space: nowrap;
    }

    .btn-dashboard-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 13px;
        color: white;
        background: var(--dash-primary);
        border: 1px solid var(--dash-primary);
        border-radius: 10px;
        font-size: .8rem;
        font-weight: 650;
        text-decoration: none;
        transition: .2s ease;
    }

    .btn-dashboard-primary:hover {
        color: white;
        background: #4338ca;
        border-color: #4338ca;
        transform: translateY(-1px);
    }

    .empty-state {
        padding: 45px 20px;
        text-align: center;
    }

    .empty-state-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 62px;
        height: 62px;
        margin: 0 auto 15px;
        color: #16a34a;
        background: #ecfdf3;
        border-radius: 20px;
        font-size: 1.7rem;
    }

    .empty-state-title {
        font-size: .95rem;
        font-weight: 700;
    }

    .empty-state-description {
        max-width: 320px;
        margin: 7px auto 16px;
        color: var(--dash-muted);
        font-size: .82rem;
        line-height: 1.6;
    }

    .task-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 28px;
        height: 26px;
        padding: 0 8px;
        color: #4f46e5;
        background: #eef2ff;
        border-radius: 8px;
        font-size: .75rem;
        font-weight: 700;
    }

    @media (max-width: 575.98px) {
        .dashboard-page {
            padding-top: 8px !important;
        }

        .welcome-panel {
            padding: 23px 20px !important;
            border-radius: 18px !important;
        }

        .dashboard-stat {
            padding: 15px;
            border-radius: 15px;
        }

        .stat-icon {
            width: 37px;
            height: 37px;
            border-radius: 11px;
        }

        .stat-label {
            margin-top: 12px;
            font-size: .74rem;
        }

        .stat-number {
            font-size: 1.65rem;
        }

        .panel-header {
            padding: 17px 15px;
        }

        .task-row {
            padding: 15px;
            gap: 10px;
        }

        .task-file-icon {
            width: 37px;
            height: 37px;
        }

        .task-deadline {
            padding: 6px 8px;
            font-size: .69rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .dashboard-page,
        .dashboard-page * {
            animation: none !important;
            transition: none !important;
        }
    }
</style>

<div class="dashboard-page container py-4">

    <!-- Welcome panel -->
    <section class="welcome-panel mb-4">
        <div class="welcome-content">
            <span class="welcome-label">
                <i class="bi bi-stars"></i>
                Ruang produktivitas Anda
            </span>

            <h1 class="welcome-title">Dashboard</h1>

            <p class="welcome-description mb-4">
                Pantau progres, kelola prioritas, dan selesaikan tugas
                Anda satu per satu. Mulai langkah produktif Anda hari ini.
            </p>

            <a href="/tasks/new" class="welcome-action">
                <i class="bi bi-plus-circle"></i>
                Buat tugas baru
            </a>
        </div>
    </section>

    <!-- Statistics -->
    <section class="mb-4">
        <div class="d-flex align-items-end justify-content-between gap-3 mb-3">
            <div>
                <h2 class="section-heading mb-1">Ringkasan aktivitas</h2>
                <p class="section-caption mb-0">
                    Gambaran singkat tugas Anda
                </p>
            </div>
        </div>

        <div class="row g-3">
            <%
                const statCards = [
                    {
                        label: 'Total tugas',
                        value: s.total,
                        icon: 'bi-grid-1x2',
                        style: 'stat-total'
                    },
                    {
                        label: 'Belum selesai',
                        value: s.open_,
                        icon: 'bi-hourglass-split',
                        style: 'stat-open'
                    },
                    {
                        label: 'Tugas selesai',
                        value: s.done,
                        icon: 'bi-check2-circle',
                        style: 'stat-done'
                    },
                    {
                        label: 'Mendekati deadline',
                        value: s.soon,
                        icon: 'bi-alarm',
                        style: 'stat-soon'
                    },
                    {
                        label: 'Terlambat',
                        value: s.late,
                        icon: 'bi-exclamation-circle',
                        style: 'stat-late'
                    },
                ];
            %>

            <% statCards.forEach(function(stat) { %>
                <div class="col-6 col-md">
                    <div class="dashboard-stat <%= stat.style %>">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="stat-icon">
                                <i class="bi <%= stat.icon %>"></i>
                            </div>
                        </div>

                        <div class="stat-label"><%= stat.label %></div>
                        <div class="stat-number">
                            <%= stat.value ?? 0 %>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </section>

    <!-- Upcoming tasks -->
    <section class="dashboard-panel">
        <div class="panel-header">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h2 class="section-heading mb-0">Tugas terdekat</h2>
                    <span class="task-count"><%= next.length %></span>
                </div>

                <p class="section-caption mb-0 mt-1">
                    Daftar tugas yang perlu Anda perhatikan
                </p>
            </div>

            <a href="/tasks/new" class="btn-dashboard-primary">
                <i class="bi bi-plus-lg"></i>
                <span class="d-none d-sm-inline">Tugas baru</span>
                <span class="d-sm-none">Tambah</span>
            </a>
        </div>

        <div class="panel-body">
            <% if (next.length) { %>
                <% next.forEach(function(t) { %>
                    <a href="/tasks/<%= t.id %>" class="task-row">
                        <div class="task-file-icon">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>

                        <div class="task-main">
                            <div class="task-title"><%= t.title %></div>
                            <div class="task-subtitle">
                                <i class="bi bi-calendar3 me-1"></i>
                                Jadwal tugas
                            </div>
                        </div>

                        <div class="task-deadline">
                            <i class="bi bi-clock me-1"></i>
                            <%= t.deadline || 'Belum ditentukan' %>
                        </div>

                        <i class="bi bi-chevron-right text-muted small"></i>
                    </a>
                <% }); %>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="bi bi-check2-all"></i>
                    </div>

                    <div class="empty-state-title">
                        Semua terlihat lebih ringan!
                    </div>

                    <p class="empty-state-description">
                        Belum ada tugas aktif yang ditampilkan.
                        Anda bisa membuat tugas baru untuk mulai menyusun
                        aktivitas berikutnya.
                    </p>

                    <a href="/tasks/new" class="btn-dashboard-primary">
                        <i class="bi bi-plus-lg"></i>
                        Buat tugas pertama
                    </a>
                </div>
            <% } %>
        </div>
    </section>

    <div class="text-center mt-4">
        <span class="section-caption">
            <i class="bi bi-shield-check me-1"></i>
            Tetap terorganisir, satu tugas dalam satu waktu.
        </span>
    </div>

</div>

<%- include('partials/foot') %>
