
<%- include('partials/head', { title: 'Verifikasi WhatsApp' }) %>

<style>
    .verify-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
        background:
            radial-gradient(ellipse at top left, rgba(99,102,241,.10), transparent 42%),
            radial-gradient(ellipse at bottom right, rgba(79,70,229,.08), transparent 40%),
            #f8fafc;
    }

    .verify-card {
        width: 100%;
        max-width: 450px;
        padding: 34px;
        border: 1px solid #e8eaf2;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 24px 65px rgba(15,23,42,.08);
        animation: verifyFadeIn .5s ease both;
    }

    @keyframes verifyFadeIn {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .verify-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 66px;
        height: 66px;
        margin: 0 auto 18px;
        border-radius: 20px;
        background: linear-gradient(135deg,#16a34a,#4ade80);
        color: #fff;
        font-size: 30px;
        box-shadow: 0 10px 24px rgba(22,163,74,.18);
    }

    .verify-title {
        color: #0f172a;
        text-align: center;
        font-size: 25px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .verify-description {
        color: #64748b;
        text-align: center;
        font-size: 14px;
        line-height: 1.7;
        margin-bottom: 22px;
    }

    .verify-phone {
        display: block;
        margin-top: 6px;
        color: #15803d;
        font-weight: 700;
    }

    .verify-label {
        display: block;
        margin-bottom: 8px;
        color: #334155;
        font-size: 13px;
        font-weight: 700;
    }

    .verify-input {
        width: 100%;
        min-height: 54px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #f8fafc;
        color: #0f172a;
        text-align: center;
        letter-spacing: 10px;
        font-size: 25px;
        font-weight: 800;
        outline: none;
        padding: 10px;
    }

    .verify-input:focus {
        border-color: #818cf8;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(99,102,241,.11);
    }

    .verify-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        min-height: 48px;
        margin-top: 18px;
        padding: 12px;
        border: 0;
        border-radius: 12px;
        color: #fff;
        background: linear-gradient(135deg,#4f46e5,#6366f1);
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
    }

    .verify-button:hover {
        background: linear-gradient(135deg,#4338ca,#4f46e5);
    }

    .verify-resend {
        width: 100%;
        margin-top: 12px;
        padding: 11px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #fff;
        color: #4f46e5;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }

    .verify-resend:hover {
        background: #eef2ff;
    }

    .verify-footer {
        margin-top: 22px;
        color: #94a3b8;
        text-align: center;
        font-size: 12px;
    }

    @media (max-width: 480px) {
        .verify-card { padding: 27px 22px; }
    }
</style>

<div class="verify-page">
    <div class="verify-card">

        <div class="verify-logo">
            <i class="bi bi-whatsapp"></i>
        </div>

        <h1 class="verify-title">Verifikasi WhatsApp</h1>

        <p class="verify-description">
            Kami mengirim kode verifikasi ke nomor WhatsApp kamu.
            Masukkan kode OTP untuk menyelesaikan pendaftaran.

            <span class="verify-phone">
                <i class="bi bi-telephone me-1"></i>
                <%= whatsapp %>
            </span>
        </p>

        <% if (typeof flash !== 'undefined' && flash) { %>
            <div class="alert alert-<%= flash.t === 'danger' ? 'danger' : flash.t === 'warning' ? 'warning' : 'success' %> alert-dismissible fade show"
                 role="alert"
                 style="border-radius:12px;font-size:13px;">
                <%= flash.m %>
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Tutup"></button>
            </div>
        <% } %>

        <form method="post" action="/register/verify">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <label class="verify-label" for="otp">
                Kode OTP 6 Digit
            </label>

            <input
                class="verify-input"
                id="otp"
                name="otp"
                type="text"
                inputmode="numeric"
                pattern="[0-9]{6}"
                minlength="6"
                maxlength="6"
                autocomplete="one-time-code"
                placeholder="••••••"
                aria-label="Kode OTP enam digit"
                required
            >

            <button type="submit" class="verify-button">
                <i class="bi bi-shield-check"></i>
                Verifikasi dan Buat Akun
            </button>
        </form>

        <form method="post" action="/register/resend-otp">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <button type="submit" class="verify-resend">
                <i class="bi bi-arrow-clockwise me-1"></i>
                Kirim Ulang OTP
            </button>
        </form>

        <div class="text-center mt-3">
            <a href="/register"
               class="text-decoration-none small">
                <i class="bi bi-arrow-left me-1"></i>
                Kembali ke pendaftaran
            </a>
        </div>

        <div class="verify-footer">
            <i class="bi bi-shield-check me-1"></i>
            &copy; 2026 Beckend-API. Secure Registration.
        </div>
    </div>
</div>

<%- include('partials/foot') %>
