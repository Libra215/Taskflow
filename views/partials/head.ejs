
<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %><%= appName %></title>

    <!-- Bootstrap 5.3.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --bs-primary: #4f46e5;
            --bs-primary-rgb: 79, 70, 229;
            --tf-primary: #4f46e5;
            --tf-primary-dark: #3730a3;
            --tf-ink: #172033;
            --tf-muted: #64748b;
            --tf-border: #e8edf5;
            --tf-surface: #ffffff;
            --tf-background: #f8fafc;
        }

        * {
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            background: var(--tf-background);
            color: var(--tf-ink);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }

        main {
            flex: 1;
            min-width: 0;
        }

        /* Announcement bar */
        .announcement-bar {
            padding: .45rem 1rem;
            background: #171a35;
            color: #dbe4ff;
            font-size: .78rem;
        }

        .announcement-bar a {
            color: #fff;
        }

        /* Header */
        .navbar-modern {
            position: sticky;
            top: 0;
            z-index: 1030;
            display: block !important;
            padding: .7rem 0 !important;
            margin-bottom: 1.5rem !important;
            background: rgba(255,255,255,.96) !important;
            border-bottom: 1px solid var(--tf-border);
            box-shadow: 0 4px 20px rgba(15,23,42,.045);
            backdrop-filter: blur(14px);
        }

        .navbar-modern .container {
            min-width: 0;
        }

        .navbar-modern .navbar-brand {
            display: inline-flex;
            align-items: center;
            gap: .7rem;
            min-width: 0;
            margin: 0;
            color: var(--tf-ink) !important;
            letter-spacing: -.5px;
            text-decoration: none;
        }

        .brand-logo-icon {
            display: inline-flex;
            flex: 0 0 43px;
            align-items: center;
            justify-content: center;
            width: 43px;
            height: 43px;
            border-radius: 14px;
            background: linear-gradient(135deg, #6366f1, #4338ca);
            color: #fff;
            box-shadow: 0 5px 12px rgba(79,70,229,.22);
        }

        .tf-brand-name {
            font-size: 1.05rem;
            font-weight: 800;
            line-height: 1.15;
        }

        .tf-brand-subtitle {
            display: block;
            margin-top: .2rem;
            color: #94a3b8;
            font-size: .61rem;
            font-weight: 600;
            letter-spacing: .08em;
        }

        /* Desktop navigation */
        .tf-desktop-nav {
            display: flex;
            align-items: center;
            gap: .15rem;
            margin-left: 1.25rem;
        }

        .navbar-modern .nav-link {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .7rem .75rem !important;
            border-radius: 11px;
            color: #475569 !important;
            font-size: .86rem;
            font-weight: 650;
            white-space: nowrap;
            transition: background .2s ease, color .2s ease;
        }

        .navbar-modern .nav-link:hover,
        .navbar-modern .nav-link.active {
            background: #eef2ff;
            color: var(--tf-primary) !important;
        }

        .tf-icon-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 42px;
            width: 42px;
            height: 42px;
            border: 1px solid var(--tf-border);
            border-radius: 13px;
            background: #fff;
            color: #334155;
            font-size: 1.35rem;
            transition: background .2s ease;
        }

        .tf-icon-button:hover {
            background: #eef2ff;
            color: var(--tf-primary);
        }

        .tf-profile-button {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            min-height: 40px;
            padding: .45rem .8rem;
            border: 1px solid var(--tf-border);
            border-radius: 12px;
            background: #fff;
            color: var(--tf-ink);
            font-size: .87rem;
            font-weight: 650;
            text-decoration: none;
        }

        .tf-profile-button:hover {
            background: #f8fafc;
            color: var(--tf-primary);
        }

        .tf-logout-button {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            min-height: 40px;
            padding: .45rem .8rem;
            border: 1px solid #fee2e2;
            border-radius: 12px;
            background: #fff;
            color: #dc2626;
            font-size: .87rem;
            font-weight: 650;
        }

        .tf-logout-button:hover {
            background: #fef2f2;
        }

        /* Mobile side drawer */
        .tf-drawer {
            --bs-offcanvas-width: min(340px, 88vw);
            width: min(340px, 88vw) !important;
            border: 0;
            background: #fff;
            box-shadow: -12px 0 40px rgba(15,23,42,.12);
        }

        .tf-drawer .offcanvas-header {
            padding: 1.2rem;
            border-bottom: 1px solid var(--tf-border);
        }

        .tf-drawer .offcanvas-body {
            display: flex;
            flex-direction: column;
            padding: 1rem;
        }

        .tf-user-card {
            display: flex;
            align-items: center;
            gap: .75rem;
            min-width: 0;
            padding: .9rem;
            margin-bottom: 1.15rem;
            border: 1px solid var(--tf-border);
            border-radius: 15px;
            background: #f8fafc;
        }

        .tf-user-avatar {
            display: inline-flex;
            flex: 0 0 43px;
            align-items: center;
            justify-content: center;
            width: 43px;
            height: 43px;
            border-radius: 14px;
            background: #e0e7ff;
            color: #4338ca;
            font-size: 1.1rem;
            font-weight: 800;
        }

        .tf-user-details {
            min-width: 0;
            overflow-wrap: anywhere;
        }

        .tf-drawer-label {
            margin: .35rem .75rem .6rem;
            color: #94a3b8;
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .1em;
            text-transform: uppercase;
        }

        .tf-drawer-link {
            display: flex;
            align-items: center;
            gap: .8rem;
            min-height: 47px;
            padding: .8rem .9rem;
            margin-bottom: .25rem;
            border-radius: 12px;
            color: #334155;
            font-size: .93rem;
            font-weight: 650;
            text-decoration: none;
            transition: background .2s ease, color .2s ease;
        }

        .tf-drawer-link i {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            font-size: 1.1rem;
        }

        .tf-drawer-link:hover,
        .tf-drawer-link.active {
            background: #eef2ff;
            color: var(--tf-primary);
        }

        .tf-drawer-footer {
            margin-top: auto;
            padding-top: 1rem;
            border-top: 1px solid var(--tf-border);
        }

        .tf-drawer-footer .btn {
            min-height: 45px;
            border-radius: 12px;
            font-weight: 650;
        }

        /* General components */
        .btn {
            border-radius: 11px;
            font-weight: 600;
        }

        .btn-primary {
            --bs-btn-bg: var(--tf-primary);
            --bs-btn-border-color: var(--tf-primary);
            --bs-btn-hover-bg: var(--tf-primary-dark);
            --bs-btn-hover-border-color: var(--tf-primary-dark);
        }

        .alert {
            border: 1px solid var(--tf-border);
            border-radius: 14px;
            box-shadow: 0 4px 12px rgba(15,23,42,.035);
        }

        /* Responsive */
        @media (max-width: 991.98px) {
            .navbar-modern {
                padding: .65rem 0 !important;
                margin-bottom: 1rem !important;
            }

            .tf-desktop-nav,
            .tf-desktop-actions {
                display: none !important;
            }

            .navbar-modern .container {
                gap: .5rem;
            }

            .navbar-modern .navbar-brand {
                flex: 1;
                overflow: hidden;
            }

            .tf-brand-name {
                font-size: 1rem;
            }

            .brand-logo-icon {
                flex-basis: 40px;
                width: 40px;
                height: 40px;
                border-radius: 13px;
            }

            main.container {
                padding-right: 1rem;
                padding-left: 1rem;
            }

            .announcement-bar {
                display: none;
            }
        }

        @media (min-width: 992px) {
            .tf-mobile-menu-button {
                display: none !important;
            }
        }

        @media (max-width: 380px) {
            .tf-brand-subtitle {
                font-size: .55rem;
            }

            .brand-logo-icon {
                flex-basis: 36px;
                width: 36px;
                height: 36px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition: none !important;
            }
        }
    </style>
</head>

<body>

    <!-- Announcement -->
    <div class="announcement-bar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                    <i class="bi bi-check-circle-fill me-1"></i> LIVE
                </span>
                <span>Selamat datang di TaskFlow — Student Productivity.</span>
            </div>
            <div>
                <i class="bi bi-life-preserver me-1"></i>
                Butuh bantuan? <a href="/docs">Baca dokumentasi</a>
            </div>
        </div>
    </div>

    <!-- Main Header -->
    <nav class="navbar navbar-modern">
        <div class="container">

            <a class="navbar-brand" href="/">
                <span class="brand-logo-icon">
                    <i class="bi bi-layers fs-5"></i>
                </span>
                <span class="d-block">
                    <span class="tf-brand-name d-block"><%= appName %></span>
                    <span class="tf-brand-subtitle">STUDENT PRODUCTIVITY</span>
                </span>
            </a>

            <% if (typeof user !== 'undefined' && user) { %>

                <!-- Desktop navigation -->
                <div class="tf-desktop-nav">
                    <% if (user.role === 'admin') { %>
                        <a class="nav-link" href="/admin">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                        <a class="nav-link" href="/admin/users">
                            <i class="bi bi-people"></i> Pengguna
                        </a>
                        <a class="nav-link" href="/docs">
                            <i class="bi bi-file-earmark-code"></i> Dokumentasi
                        </a>
                    <% } else { %>
                        <a class="nav-link" href="/dashboard">
                            <i class="bi bi-grid"></i> Dashboard
                        </a>
                        <a class="nav-link" href="/tasks">
                            <i class="bi bi-check2-square"></i> Tugas
                        </a>
                        <a class="nav-link" href="/calendar">
                            <i class="bi bi-calendar3"></i> Kalender
                        </a>

                        <a class="tf-drawer-link" href="/community">
                            <i class="bi bi-chat-dots"></i> Community
                        </a>
                        <a class="nav-link" href="/groups">
                            <i class="bi bi-people"></i> Grup
                        </a>
                        <a class="tf-drawer-link" href="/reminders">
                            <i class="bi bi-bell"></i>
                        <span>Pengingat</span>
                        <span class="badge bg-warning text-dark ms-auto">New</span>
                        </a>
                    <% } %>
                </div>

                <!-- Desktop account actions -->
                <div class="tf-desktop-actions d-flex align-items-center gap-2 ms-auto">
                    <a href="/profile" class="tf-profile-button">
                        <i class="bi bi-person-circle fs-5"></i>
                        Profil
                    </a>

                    <form method="post" action="/logout" class="m-0">
                        <input type="hidden" name="_csrf"
                               value="<%= typeof csrf !== 'undefined' ? csrf : '' %>">
                        <button type="submit" class="tf-logout-button">
                            <i class="bi bi-box-arrow-right"></i>
                            Keluar
                        </button>
                    </form>
                </div>

                <!-- Mobile menu trigger -->
                <button
                    class="tf-icon-button tf-mobile-menu-button"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#taskflowDrawer"
                    aria-controls="taskflowDrawer"
                    aria-label="Buka menu navigasi">
                    <i class="bi bi-list"></i>
                </button>

            <% } else { %>

                <!-- Guest navigation -->
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <a class="btn btn-outline-primary px-3 py-2" href="/login">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        Masuk
                    </a>
                    <a class="btn btn-primary px-3 py-2" href="/register">
                        <i class="bi bi-person-plus me-1"></i>
                        Daftar
                    </a>
                </div>

            <% } %>
        </div>
    </nav>

    <!-- Mobile side drawer -->
    <% if (typeof user !== 'undefined' && user) { %>
        <div
            class="offcanvas offcanvas-end tf-drawer"
            tabindex="-1"
            id="taskflowDrawer"
            aria-labelledby="taskflowDrawerLabel">

            <div class="offcanvas-header">
                <a href="/" class="navbar-brand d-flex align-items-center gap-2 text-decoration-none">
                    <span class="brand-logo-icon">
                        <i class="bi bi-layers fs-5"></i>
                    </span>
                    <span>
                        <span class="tf-brand-name d-block"><%= appName %></span>
                        <span class="tf-brand-subtitle">STUDENT PRODUCTIVITY</span>
                    </span>
                </a>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas"
                    aria-label="Tutup menu"></button>
            </div>

            <div class="offcanvas-body">

                <!-- User identity -->
                <div class="tf-user-card">
                    <span class="tf-user-avatar">
                        <%= (user.name || 'U').trim().charAt(0).toUpperCase() %>
                    </span>
                    <div class="tf-user-details">
                        <div class="fw-bold"><%= user.name || 'Pengguna TaskFlow' %></div>
                        <div class="small text-secondary">
                            <%= user.role === 'admin' ? 'Administrator' : 'Pengguna TaskFlow' %>
                        </div>
                    </div>
                </div>

                <div class="tf-drawer-label">Menu utama</div>

                <% if (user.role === 'admin') { %>

                    <a class="tf-drawer-link" href="/admin">
                        <i class="bi bi-speedometer2"></i>
                        Dashboard
                    </a>

                    <a class="tf-drawer-link" href="/admin/users">
                        <i class="bi bi-people"></i>
                        Pengguna
                    </a>

                    <a class="tf-drawer-link" href="/docs">
                        <i class="bi bi-file-earmark-code"></i>
                        Dokumentasi
                    </a>

                <% } else { %>

                    
                    <a class="tf-drawer-link" href="/dashboard">
                        <i class="bi bi-grid"></i>
                        <span>Dashboard</span>
                    </a>
                    
                    <a class="tf-drawer-link" href="/tasks">
                        <i class="bi bi-check2-square"></i>
                        <span>Tugas</span>
                    </a>
                    
                    <a class="tf-drawer-link" href="/calendar">
                        <i class="bi bi-calendar3"></i>
                        <span>Kalender</span>
                    </a>
                    
                    <a class="tf-drawer-link" href="/groups">
                        <i class="bi bi-people"></i>
                        <span>Tugas Kelompok</span>
                    </a>
                    
                    <a class="tf-drawer-link" href="/community">
                        <i class="bi bi-chat-dots"></i>
                        <span>Community</span>
                        <span class="badge bg-primary ms-auto">Live</span>
                    </a>
                    
                    <a class="tf-drawer-link" href="/reminders">
                        <i class="bi bi-bell"></i>
                        <span>Pengingat</span>
                        <span class="badge bg-warning text-dark ms-auto">New</span>
                    </a>

                <% } %>

                <div class="tf-drawer-label mt-4">Akun & bantuan</div>

                <a class="tf-drawer-link" href="/profile">
                    <i class="bi bi-person-circle"></i>
                    Profil Saya
                </a>

                <a class="tf-drawer-link" href="/docs">
                    <i class="bi bi-file-earmark-code"></i>
                    Dokumentasi
                </a>

                <div class="tf-drawer-footer">
                    <form method="post" action="/logout" class="d-grid">
                        <input type="hidden" name="_csrf"
                               value="<%= typeof csrf !== 'undefined' ? csrf : '' %>">
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>
                            Keluar dari akun
                        </button>
                    </form>
                </div>

            </div>
        </div>
    <% } %>

    <!-- Main content -->
    <main class="container pb-5">

        <% if (typeof flash !== 'undefined' && flash) { %>
            <div
                class="alert alert-<%= flash.t %> alert-dismissible fade show mb-4"
                role="alert">

                <div class="d-flex align-items-center gap-2">
                    <i class="bi <%= flash.t === 'success'
                        ? 'bi-check-circle-fill text-success'
                        : 'bi-exclamation-triangle-fill text-danger' %> fs-5"></i>

                    <div><%= flash.m %></div>
                </div>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Tutup"></button>
            </div>
        <% } %>
