
<%- include('partials/head', { title: group.name }) %>

<style>
  .group-detail-page {
    max-width: 1180px;
    margin: 0 auto;
    color: #172033;
  }

  .group-detail-page * {
    box-sizing: border-box;
  }

  .gd-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    color: #64748b;
    font-size: .88rem;
    font-weight: 650;
    text-decoration: none;
  }

  .gd-back:hover {
    color: #4f46e5;
  }

  .gd-hero {
    position: relative;
    overflow: hidden;
    padding: 27px;
    border: 1px solid #e0e7ff;
    border-radius: 23px;
    background: linear-gradient(125deg, #eef2ff, #fff 68%, #f5f3ff);
  }

  .gd-hero::after {
    position: absolute;
    top: -85px;
    right: -50px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: rgba(99,102,241,.07);
    content: "";
    pointer-events: none;
  }

  .gd-hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .gd-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 10px;
    border: 1px solid #c7d2fe;
    border-radius: 999px;
    background: rgba(255,255,255,.8);
    color: #4338ca;
    font-size: .72rem;
    font-weight: 750;
    letter-spacing: .04em;
  }

  .gd-hero h1 {
    margin: 13px 0 8px;
    font-size: clamp(1.55rem, 4vw, 2.2rem);
    font-weight: 850;
    letter-spacing: -.7px;
    overflow-wrap: anywhere;
  }

  .gd-hero-description {
    max-width: 650px;
    margin: 0;
    color: #64748b;
    font-size: .93rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
    white-space: pre-line;
  }

  .gd-hero-icon {
    display: flex;
    flex: 0 0 70px;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    border-radius: 21px;
    background: linear-gradient(135deg, #6366f1, #4338ca);
    color: #fff;
    font-size: 1.8rem;
    box-shadow: 0 10px 24px rgba(79,70,229,.2);
  }

  .gd-role-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 15px;
    padding: 7px 11px;
    border: 1px solid #c7d2fe;
    border-radius: 9px;
    background: #eef2ff;
    color: #4338ca;
    font-size: .78rem;
    font-weight: 750;
  }

  .gd-alert {
    margin-top: 20px;
    border-radius: 13px;
  }

  .gd-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: 20px;
    margin-top: 24px;
  }

  .gd-column {
    display: grid;
    min-width: 0;
    gap: 20px;
  }

  .gd-panel {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #e8edf5;
    border-radius: 19px;
    background: #fff;
    box-shadow: 0 5px 24px rgba(15,23,42,.035);
  }

  .gd-panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 20px 22px 16px;
    border-bottom: 1px solid #edf0f5;
  }

  .gd-panel-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
  }

  .gd-title-icon {
    display: inline-flex;
    flex: 0 0 36px;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: #eef2ff;
    color: #4f46e5;
    font-size: 1rem;
  }

  .gd-panel-subtitle {
    margin: 6px 0 0 46px;
    color: #94a3b8;
    font-size: .8rem;
    line-height: 1.6;
  }

  .gd-panel-body {
    padding: 21px 22px;
  }

  .gd-detail-page .form-label,
  .group-detail-page .form-label {
    margin-bottom: 8px;
    color: #334155;
    font-size: .85rem;
    font-weight: 700;
  }

  .group-detail-page .form-control,
  .group-detail-page .form-select {
    min-height: 45px;
    border: 1px solid #dfe5ee;
    border-radius: 11px;
    font-size: .9rem;
  }

  .group-detail-page textarea.form-control {
    min-height: 100px;
    resize: vertical;
  }

  .group-detail-page .form-control:focus,
  .group-detail-page .form-select:focus {
    border-color: #818cf8;
    box-shadow: 0 0 0 3px rgba(99,102,241,.1);
  }

  .gd-field-help {
    margin-top: 7px;
    color: #94a3b8;
    font-size: .77rem;
    line-height: 1.6;
  }

  .gd-primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 45px;
    padding: 10px 16px;
    border: 0;
    border-radius: 11px;
    background: linear-gradient(135deg, #4f46e5, #4338ca);
    color: #fff;
    font-size: .88rem;
    font-weight: 750;
    transition: box-shadow .2s, transform .2s;
  }

  .gd-primary-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 7px 16px rgba(79,70,229,.2);
    color: #fff;
  }

  .gd-primary-button:focus-visible,
  .gd-secondary-button:focus-visible,
  .gd-back:focus-visible {
    outline: 3px solid rgba(99,102,241,.35);
    outline-offset: 3px;
  }

  .gd-secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 40px;
    padding: 8px 12px;
    border: 1px solid #dfe5ee;
    border-radius: 10px;
    background: #fff;
    color: #475569;
    font-size: .82rem;
    font-weight: 700;
  }

  .gd-secondary-button:hover {
    background: #f8fafc;
    color: #4338ca;
  }

  .gd-member-list {
    display: grid;
    gap: 0;
  }

  .gd-member {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding: 14px 0;
    border-bottom: 1px solid #edf0f5;
  }

  .gd-member:first-child {
    padding-top: 0;
  }

  .gd-member:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .gd-avatar {
    display: flex;
    flex: 0 0 42px;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 13px;
    background: #eef2ff;
    color: #4338ca;
    font-size: 1rem;
    font-weight: 800;
  }

  .gd-member-info {
    flex: 1;
    min-width: 0;
  }

  .gd-member-name {
    margin-bottom: 4px;
    font-size: .9rem;
    font-weight: 750;
    overflow-wrap: anywhere;
  }

  .gd-member-email {
    color: #94a3b8;
    font-size: .79rem;
    overflow-wrap: anywhere;
  }

  .gd-member-role {
    flex: 0 0 auto;
    padding: 6px 9px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background: #f8fafc;
    color: #475569;
    font-size: .73rem;
    font-weight: 700;
  }

  .gd-task-list {
    display: grid;
    gap: 13px;
  }

  .gd-task {
    min-width: 0;
    padding: 17px;
    border: 1px solid #e8edf5;
    border-radius: 15px;
    background: #fff;
    transition: border-color .2s, box-shadow .2s;
  }

  .gd-task:hover {
    border-color: #c7d2fe;
    box-shadow: 0 5px 16px rgba(15,23,42,.035);
  }

  .gd-task-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .gd-task-title {
    margin: 0;
    font-size: .95rem;
    font-weight: 800;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .gd-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: 0 0 auto;
    padding: 6px 9px;
    border-radius: 8px;
    background: #f1f5f9;
    color: #475569;
    font-size: .7rem;
    font-weight: 750;
  }

  .gd-status-belum {
    background: #fff7ed;
    color: #c2410c;
  }

  .gd-status-proses {
    background: #eff6ff;
    color: #1d4ed8;
  }

  .gd-status-selesai {
    background: #ecfdf5;
    color: #047857;
  }

  .gd-task-description {
    margin: 0 0 13px;
    color: #64748b;
    font-size: .84rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
    white-space: pre-line;
  }

  .gd-task-meta {
    display: grid;
    gap: 9px;
    padding: 12px;
    margin-bottom: 15px;
    border-radius: 11px;
    background: #f8fafc;
  }

  .gd-meta-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: #64748b;
    font-size: .8rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .gd-meta-row i {
    flex: 0 0 auto;
    margin-top: 2px;
    color: #6366f1;
  }

  .gd-status-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 10px;
    padding-top: 13px;
    border-top: 1px solid #edf0f5;
  }

  .gd-status-form .form-label {
    display: block;
    margin-bottom: 6px;
    font-size: .78rem;
  }

  .gd-status-form .form-select {
    min-height: 41px;
    font-size: .83rem;
  }

  .gd-status-form .gd-secondary-button {
    min-height: 41px;
    border-color: #c7d2fe;
    color: #4338ca;
  }

  .gd-status-form .gd-secondary-button:hover {
    background: #eef2ff;
  }

  .gd-empty {
    padding: 30px 18px;
    border: 1px dashed #d5ddeb;
    border-radius: 14px;
    background: #fafbff;
    text-align: center;
  }

  .gd-empty-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    margin: 0 auto 13px;
    border-radius: 16px;
    background: #eef2ff;
    color: #4f46e5;
    font-size: 1.4rem;
  }

  .gd-empty h3 {
    margin-bottom: 6px;
    font-size: .93rem;
    font-weight: 800;
  }

  .gd-empty p {
    margin: 0;
    color: #94a3b8;
    font-size: .82rem;
    line-height: 1.65;
  }

  @media (max-width: 767.98px) {
    .gd-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      margin-top: 19px;
    }

    .gd-column {
      gap: 18px;
    }

    .gd-hero {
      padding: 21px;
      border-radius: 19px;
    }

    .gd-hero-icon {
      flex-basis: 53px;
      width: 53px;
      height: 53px;
      border-radius: 16px;
      font-size: 1.4rem;
    }

    .gd-panel {
      border-radius: 16px;
    }

    .gd-panel-header {
      padding: 17px;
    }

    .gd-panel-body {
      padding: 17px;
    }

    .gd-task {
      padding: 15px;
    }
  }

  @media (max-width: 420px) {
    .gd-hero {
      padding: 18px;
    }

    .gd-hero h1 {
      font-size: 1.45rem;
    }

    .gd-hero-description {
      font-size: .86rem;
    }

    .gd-panel-title {
      font-size: .94rem;
    }

    .gd-panel-header {
      gap: 8px;
    }

    .gd-status-form {
      grid-template-columns: minmax(0, 1fr);
    }

    .gd-status-form .gd-secondary-button {
      width: 100%;
    }

    .gd-member {
      gap: 9px;
    }

    .gd-avatar {
      flex-basis: 37px;
      width: 37px;
      height: 37px;
    }

    .gd-member-role {
      padding: 5px 7px;
      font-size: .68rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .group-detail-page *,
    .group-detail-page *::before,
    .group-detail-page *::after {
      transition: none !important;
    }
  }
</style>

<div class="container py-3 py-lg-4">
  <div class="group-detail-page">

    <!-- Kembali -->
    <a href="/groups" class="gd-back">
      <i class="bi bi-arrow-left"></i>
      Kembali ke kelompok
    </a>

    <!-- Header kelompok -->
    <section class="gd-hero">
      <div class="gd-hero-content">
        <div class="flex-grow-1">
          <span class="gd-eyebrow">
            <i class="bi bi-people-fill"></i>
            RUANG KOLABORASI
          </span>

          <h1><%= group.name %></h1>

          <p class="gd-hero-description"><%= group.description || 'Kelompok tugas dan kolaborasi akademik.' %></p>

          <span class="gd-role-badge">
            <i class="bi bi-shield-check"></i>
            Peran: <%= group.role %>
          </span>
        </div>

        <div class="gd-hero-icon d-none d-sm-flex">
          <i class="bi bi-people"></i>
        </div>
      </div>
    </section>

    <!-- Flash message -->
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="alert alert-<%= flash.t %> alert-dismissible fade show gd-alert"
           role="alert">
        <div class="d-flex align-items-center gap-2">
          <i class="bi <%= flash.t === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill' %>"></i>
          <div><%= flash.m %></div>
        </div>
        <button type="button" class="btn-close"
                data-bs-dismiss="alert" aria-label="Tutup"></button>
      </div>
    <% } %>

    <div class="gd-layout">

      <!-- Kolom kiri: anggota dan form -->
      <div class="gd-column">

        <% if (group.role === 'ketua') { %>
          <section class="gd-panel">
            <div class="gd-panel-header">
              <div>
                <h2 class="gd-panel-title">
                  <span class="gd-title-icon">
                    <i class="bi bi-person-plus"></i>
                  </span>
                  Tambah Anggota
                </h2>
                <p class="gd-panel-subtitle">
                  Undang pengguna TaskFlow melalui email.
                </p>
              </div>
            </div>

            <div class="gd-panel-body">
              <form method="POST" action="/groups/<%= group.id %>/members">
                <input type="hidden" name="_csrf" value="<%= csrf %>">

                <div class="mb-3">
                  <label for="memberEmail" class="form-label">
                    Alamat email anggota
                  </label>

                  <input
                    type="email"
                    id="memberEmail"
                    name="email"
                    class="form-control"
                    placeholder="nama@contoh.com"
                    autocomplete="email"
                    required>

                  <div class="gd-field-help">
                    Pastikan anggota sudah memiliki akun TaskFlow aktif.
                  </div>
                </div>

                <button type="submit" class="gd-primary-button w-100">
                  <i class="bi bi-person-add"></i>
                  Tambah Anggota
                </button>
              </form>
            </div>
          </section>
        <% } %>

        <!-- Daftar anggota -->
        <section class="gd-panel">
          <div class="gd-panel-header">
            <div>
              <h2 class="gd-panel-title">
                <span class="gd-title-icon">
                  <i class="bi bi-people"></i>
                </span>
                Anggota Kelompok
              </h2>
              <p class="gd-panel-subtitle">
                Anggota yang tergabung dalam kelompok ini.
              </p>
            </div>

            <span class="badge rounded-pill text-bg-light border">
              <%= members.length %>
            </span>
          </div>

          <div class="gd-panel-body">
            <% if (!members.length) { %>
              <div class="gd-empty">
                <div class="gd-empty-icon">
                  <i class="bi bi-person-x"></i>
                </div>
                <h3>Belum ada anggota</h3>
                <p>Daftar anggota akan ditampilkan di sini.</p>
              </div>
            <% } else { %>
              <div class="gd-member-list">
                <% members.forEach(member => { %>
                  <div class="gd-member">
                    <div class="gd-avatar">
                      <%= (member.name || 'U').trim().charAt(0).toUpperCase() %>
                    </div>

                    <div class="gd-member-info">
                      <div class="gd-member-name">
                        <%= member.name %>
                      </div>
                      <div class="gd-member-email">
                        <%= member.email %>
                      </div>
                    </div>

                    <span class="gd-member-role">
                      <%= member.role %>
                    </span>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </section>

        <!-- Form pembuatan tugas -->
        <section class="gd-panel">
          <div class="gd-panel-header">
            <div>
              <h2 class="gd-panel-title">
                <span class="gd-title-icon">
                  <i class="bi bi-plus-square"></i>
                </span>
                Buat Tugas Kelompok
              </h2>
              <p class="gd-panel-subtitle">
                Buat pekerjaan baru dan tentukan penanggung jawabnya.
              </p>
            </div>
          </div>

          <div class="gd-panel-body">
            <form method="POST" action="/groups/<%= group.id %>/tasks">
              <input type="hidden" name="_csrf" value="<%= csrf %>">

              <div class="mb-3">
                <label for="taskTitle" class="form-label">
                  Nama tugas <span class="text-danger">*</span>
                </label>
                <input
                  id="taskTitle"
                  name="title"
                  class="form-control"
                  maxlength="200"
                  placeholder="Contoh: Menyusun laporan proyek"
                  required>
              </div>

              <div class="mb-3">
                <label for="taskDescription" class="form-label">
                  Deskripsi tugas
                </label>
                <textarea
                  id="taskDescription"
                  name="description"
                  class="form-control"
                  rows="3"
                  maxlength="5000"
                  placeholder="Jelaskan hasil yang perlu dikerjakan..."></textarea>
              </div>

              <div class="mb-3">
                <label for="assignedTo" class="form-label">
                  Penanggung jawab
                </label>
                <select id="assignedTo" name="assigned_to" class="form-select">
                  <option value="">Belum ditentukan</option>
                  <% members.forEach(member => { %>
                    <option value="<%= member.id %>">
                      <%= member.name %>
                    </option>
                  <% }) %>
                </select>
              </div>

              <div class="mb-4">
                <label for="taskDeadline" class="form-label">
                  Deadline
                </label>
                <input
                  type="datetime-local"
                  id="taskDeadline"
                  name="deadline"
                  class="form-control">
                <div class="gd-field-help">
                  Pilih batas waktu penyelesaian jika sudah ditentukan.
                </div>
              </div>

              <button type="submit" class="gd-primary-button w-100">
                <i class="bi bi-check2-circle"></i>
                Simpan Tugas
              </button>
            </form>
          </div>
        </section>

      </div>

      <!-- Kolom kanan: daftar pekerjaan -->
      <div class="gd-column">
        <section class="gd-panel">
          <div class="gd-panel-header">
            <div>
              <h2 class="gd-panel-title">
                <span class="gd-title-icon">
                  <i class="bi bi-list-check"></i>
                </span>
                Daftar Pekerjaan
              </h2>
              <p class="gd-panel-subtitle">
                Pantau tugas dan perbarui status pengerjaan.
              </p>
            </div>

            <span class="badge rounded-pill text-bg-light border">
              <%= tasks.length %>
            </span>
          </div>

          <div class="gd-panel-body">
            <% if (!tasks.length) { %>
              <div class="gd-empty">
                <div class="gd-empty-icon">
                  <i class="bi bi-clipboard2-check"></i>
                </div>
                <h3>Belum ada tugas</h3>
                <p>
                  Tugas yang dibuat untuk kelompok ini akan muncul di sini.
                </p>
              </div>
            <% } else { %>

              <div class="gd-task-list">
                <% tasks.forEach(task => { %>
                  <article class="gd-task">

                    <div class="gd-task-heading">
                      <h3 class="gd-task-title">
                        <%= task.title %>
                      </h3>

                      <span class="gd-status-pill <%= ({
                        belum: 'gd-status-belum',
                        proses: 'gd-status-proses',
                        selesai: 'gd-status-selesai'
                      })[task.status] || '' %>">
                        <i class="bi <%= task.status === 'selesai'
                          ? 'bi-check-circle-fill'
                          : task.status === 'proses'
                            ? 'bi-arrow-repeat'
                            : 'bi-clock' %>"></i>
                        <%= task.status %>
                      </span>
                    </div>

                    <% if (task.description) { %>
                      <p class="gd-task-description"><%= task.description %></p>
                    <% } %>

                    <div class="gd-task-meta">
                      <div class="gd-meta-row">
                        <i class="bi bi-person-check"></i>
                        <span>
                          <strong>Penanggung jawab:</strong>
                          <%= task.assignee_name || 'Belum ditentukan' %>
                        </span>
                      </div>

                      <div class="gd-meta-row">
                        <i class="bi bi-calendar-event"></i>
                        <span>
                          <strong>Deadline:</strong>
                          <%= task.deadline || 'Belum ditentukan' %>
                        </span>
                      </div>
                    </div>

                    <form
                      method="POST"
                      action="/groups/<%= group.id %>/tasks/<%= task.id %>/status"
                      class="gd-status-form">

                      <input type="hidden" name="_csrf" value="<%= csrf %>">

                      <div>
                        <label for="status-<%= task.id %>" class="form-label">
                          Ubah status
                        </label>
                        <select
                          id="status-<%= task.id %>"
                          name="status"
                          class="form-select">

                          <% ['belum', 'proses', 'selesai'].forEach(status => { %>
                            <option
                              value="<%= status %>"
                              <%= task.status === status ? 'selected' : '' %>>
                              <%= status === 'belum'
                                ? 'Belum dikerjakan'
                                : status === 'proses'
                                  ? 'Sedang dikerjakan'
                                  : 'Selesai' %>
                            </option>
                          <% }) %>
                        </select>
                      </div>

                      <button type="submit" class="gd-secondary-button">
                        <i class="bi bi-check2"></i>
                        Simpan
                      </button>
                    </form>

                  </article>
                <% }) %>
              </div>

            <% } %>
          </div>
        </section>
      </div>

    </div>
  </div>
</div>

<%- include('partials/foot') %>
