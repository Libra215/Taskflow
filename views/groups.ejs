
<%- include('partials/head', { title: 'Tugas Kelompok' }) %>

<style>
  .groups-page {
    max-width: 1180px;
    margin: 0 auto;
    color: #172033;
  }

  .groups-page * {
    box-sizing: border-box;
  }

  .groups-hero {
    position: relative;
    overflow: hidden;
    padding: 30px;
    border: 1px solid #e0e7ff;
    border-radius: 24px;
    background: linear-gradient(125deg, #eef2ff 0%, #ffffff 65%, #f5f3ff 100%);
  }

  .groups-hero::after {
    content: "";
    position: absolute;
    right: -45px;
    top: -75px;
    width: 210px;
    height: 210px;
    border-radius: 50%;
    background: rgba(99, 102, 241, .08);
    pointer-events: none;
  }

  .groups-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 11px;
    border: 1px solid #c7d2fe;
    border-radius: 999px;
    background: rgba(255,255,255,.8);
    color: #4338ca;
    font-size: .76rem;
    font-weight: 700;
  }

  .groups-hero h1 {
    margin: 14px 0 8px;
    font-size: clamp(1.65rem, 4vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -.8px;
  }

  .groups-hero p {
    max-width: 600px;
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .groups-hero-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 76px;
    height: 76px;
    flex: 0 0 76px;
    border-radius: 22px;
    background: linear-gradient(135deg, #6366f1, #4338ca);
    color: #fff;
    font-size: 2rem;
    box-shadow: 0 12px 25px rgba(79, 70, 229, .2);
  }

  .groups-layout {
    display: grid;
    grid-template-columns: minmax(270px, .8fr) minmax(0, 1.7fr);
    align-items: start;
    gap: 24px;
    margin-top: 28px;
  }

  .groups-panel {
    overflow: hidden;
    border: 1px solid #e8edf5;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 5px 24px rgba(15, 23, 42, .035);
  }

  .groups-panel-header {
    padding: 22px 23px 17px;
    border-bottom: 1px solid #edf0f5;
  }

  .groups-panel-header h2 {
    margin: 0 0 5px;
    font-size: 1.05rem;
    font-weight: 750;
  }

  .groups-panel-header p {
    margin: 0;
    color: #94a3b8;
    font-size: .84rem;
    line-height: 1.6;
  }

  .groups-panel-body {
    padding: 23px;
  }

  .groups-page .form-label {
    margin-bottom: 8px;
    color: #334155;
    font-size: .86rem;
    font-weight: 650;
  }

  .groups-page .form-control {
    min-height: 46px;
    padding: 11px 13px;
    border: 1px solid #dfe5ee;
    border-radius: 11px;
    background-color: #fff;
    font-size: .92rem;
  }

  .groups-page textarea.form-control {
    min-height: 112px;
    resize: vertical;
  }

  .groups-page .form-control:focus {
    border-color: #818cf8;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, .11);
  }

  .groups-page .form-text {
    margin-top: 7px;
    color: #94a3b8;
    font-size: .78rem;
    line-height: 1.6;
  }

  .groups-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 47px;
    margin-top: 4px;
    border: 0;
    border-radius: 12px;
    background: linear-gradient(135deg, #4f46e5, #4338ca);
    color: #fff;
    font-weight: 700;
    box-shadow: 0 5px 12px rgba(79, 70, 229, .17);
    transition: transform .2s, box-shadow .2s;
  }

  .groups-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 17px rgba(79, 70, 229, .23);
    color: #fff;
  }

  .groups-tip {
    display: flex;
    gap: 11px;
    padding: 13px;
    margin-top: 17px;
    border: 1px solid #e0e7ff;
    border-radius: 12px;
    background: #f5f7ff;
    color: #64748b;
    font-size: .8rem;
    line-height: 1.65;
  }

  .groups-tip i {
    flex: 0 0 auto;
    color: #6366f1;
    font-size: 1.05rem;
  }

  .groups-list-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .groups-list-heading h2 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -.3px;
  }

  .groups-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 30px;
    padding: 0 10px;
    border-radius: 999px;
    background: #eef2ff;
    color: #4338ca;
    font-size: .8rem;
    font-weight: 750;
  }

  .groups-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
  }

  .group-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 19px;
    border: 1px solid #e8edf5;
    border-radius: 17px;
    background: #fff;
    box-shadow: 0 4px 17px rgba(15, 23, 42, .025);
    transition: border-color .2s, box-shadow .2s, transform .2s;
  }

  .group-card:hover {
    transform: translateY(-2px);
    border-color: #c7d2fe;
    box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
  }

  .group-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 16px;
  }

  .group-role {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    max-width: 65%;
    padding: 6px 9px;
    overflow: hidden;
    border: 1px solid #c7d2fe;
    border-radius: 8px;
    background: #eef2ff;
    color: #4338ca;
    font-size: .72rem;
    font-weight: 750;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .group-members {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #64748b;
    font-size: .76rem;
    white-space: nowrap;
  }

  .group-card h3 {
    margin: 0 0 9px;
    overflow-wrap: anywhere;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.5;
  }

  .group-description {
    display: -webkit-box;
    min-height: 45px;
    margin: 0 0 17px;
    overflow: hidden;
    color: #64748b;
    font-size: .84rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
  }

  .group-card-divider {
    height: 1px;
    margin: auto 0 14px;
    background: #edf0f5;
  }

  .group-card-meta {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 15px;
    color: #64748b;
    font-size: .81rem;
  }

  .group-card-meta i {
    color: #6366f1;
    font-size: 1rem;
  }

  .group-open {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 43px;
    padding: 10px 12px;
    border: 1px solid #c7d2fe;
    border-radius: 11px;
    background: #fff;
    color: #4338ca;
    font-size: .84rem;
    font-weight: 700;
    text-decoration: none;
    transition: background .2s, color .2s;
  }

  .group-open:hover {
    background: #4f46e5;
    color: #fff;
  }

  .groups-empty {
    padding: 38px 20px;
    border: 1px dashed #d5ddeb;
    border-radius: 17px;
    background: #fff;
    text-align: center;
  }

  .groups-empty-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 62px;
    height: 62px;
    margin: 0 auto 15px;
    border-radius: 19px;
    background: #eef2ff;
    color: #4f46e5;
    font-size: 1.7rem;
  }

  .groups-empty h3 {
    margin-bottom: 7px;
    font-size: 1rem;
    font-weight: 750;
  }

  .groups-empty p {
    max-width: 330px;
    margin: 0 auto;
    color: #64748b;
    font-size: .86rem;
    line-height: 1.7;
  }

  .groups-page .alert {
    border-radius: 12px;
  }

  @media (max-width: 991.98px) {
    .groups-layout {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .groups-create-panel {
      order: 1;
    }

    .groups-list-panel {
      order: 2;
    }
  }

  @media (max-width: 575.98px) {
    .groups-page {
      padding-right: 0;
      padding-left: 0;
    }

    .groups-hero {
      padding: 21px 18px;
      border-radius: 19px;
    }

    .groups-hero-icon {
      width: 52px;
      height: 52px;
      flex-basis: 52px;
      border-radius: 15px;
      font-size: 1.45rem;
    }

    .groups-hero h1 {
      margin-top: 12px;
      font-size: 1.55rem;
    }

    .groups-hero p {
      font-size: .88rem;
    }

    .groups-layout {
      margin-top: 20px;
      gap: 20px;
    }

    .groups-panel {
      border-radius: 16px;
    }

    .groups-panel-header {
      padding: 18px 17px 15px;
    }

    .groups-panel-body {
      padding: 17px;
    }

    .groups-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .group-card {
      padding: 17px;
      border-radius: 15px;
    }

    .group-description {
      min-height: auto;
    }

    .groups-list-heading h2 {
      font-size: 1.08rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .groups-page *,
    .groups-page *::before,
    .groups-page *::after {
      transition: none !important;
    }
  }
</style>

<div class="container py-3 py-lg-4">
  <div class="groups-page">

    <!-- Header halaman -->
    <section class="groups-hero">
      <div class="d-flex align-items-start justify-content-between gap-3">
        <div class="flex-grow-1 position-relative" style="z-index:1">
          <span class="groups-eyebrow">
            <i class="bi bi-people-fill"></i>
            KOLABORASI AKADEMIK
          </span>

          <h1>Tugas Kelompok</h1>
          <p>
            Kelola tim, koordinasikan pekerjaan, dan pantau progres tugas
            bersama dalam satu tempat.
          </p>
        </div>

        <div class="groups-hero-icon d-none d-sm-flex">
          <i class="bi bi-people"></i>
        </div>
      </div>
    </section>

    <!-- Notifikasi -->
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="alert alert-<%= flash.t %> alert-dismissible fade show mt-4 mb-0"
           role="alert">
        <div class="d-flex align-items-center gap-2">
          <i class="bi <%= flash.t === 'success'
            ? 'bi-check-circle-fill'
            : 'bi-exclamation-triangle-fill' %>"></i>
          <div><%= flash.m %></div>
        </div>
        <button type="button" class="btn-close"
                data-bs-dismiss="alert" aria-label="Tutup"></button>
      </div>
    <% } %>

    <div class="groups-layout">

      <!-- Form buat kelompok -->
      <section class="groups-panel groups-create-panel">
        <div class="groups-panel-header">
          <h2>
            <i class="bi bi-plus-circle text-primary me-2"></i>
            Buat Kelompok Baru
          </h2>
          <p>Mulai ruang kolaborasi untuk proyek atau tugas bersama.</p>
        </div>

        <div class="groups-panel-body">
          <form method="POST" action="/groups">
            <input type="hidden" name="_csrf" value="<%= csrf %>">

            <div class="mb-4">
              <label for="groupName" class="form-label">
                Nama kelompok <span class="text-danger">*</span>
              </label>
              <input
                id="groupName"
                name="name"
                class="form-control"
                minlength="3"
                maxlength="150"
                required
                autocomplete="off"
                placeholder="Contoh: Tim Proyek Sistem Informasi">

              <div class="form-text">
                Gunakan nama yang singkat dan mudah dikenali anggota.
              </div>
            </div>

            <div class="mb-4">
              <label for="groupDescription" class="form-label">
                Deskripsi kelompok
              </label>
              <textarea
                id="groupDescription"
                name="description"
                class="form-control"
                rows="4"
                maxlength="5000"
                placeholder="Jelaskan tujuan atau topik proyek kelompok..."></textarea>

              <div class="form-text">
                Opsional. Kamu bisa menjelaskan tujuan dan ruang lingkup tugas.
              </div>
            </div>

            <button type="submit" class="groups-submit">
              <i class="bi bi-plus-lg"></i>
              Buat Kelompok
            </button>
          </form>

          <div class="groups-tip">
            <i class="bi bi-lightbulb-fill"></i>
            <div>
              <strong class="d-block mb-1">Tips kolaborasi</strong>
              Tentukan tujuan kelompok sejak awal agar pembagian tugas lebih
              jelas dan kerja sama berjalan efektif.
            </div>
          </div>
        </div>
      </section>

      <!-- Daftar kelompok -->
      <section class="groups-list-panel">
        <div class="groups-list-heading">
          <div>
            <h2>Kelompok Saya</h2>
            <div class="text-secondary small mt-1">
              Daftar ruang kolaborasi yang kamu ikuti.
            </div>
          </div>

          <span class="groups-count" title="Jumlah kelompok">
            <%= groups.length %>
          </span>
        </div>

        <% if (!groups.length) { %>
          <div class="groups-empty">
            <div class="groups-empty-icon">
              <i class="bi bi-people"></i>
            </div>
            <h3>Belum ada kelompok</h3>
            <p>
              Kamu belum tergabung dalam kelompok mana pun.
              Buat kelompok baru menggunakan formulir di samping atau di atas.
            </p>
          </div>
        <% } else { %>

          <div class="groups-grid">
            <% groups.forEach(group => { %>
              <article class="group-card">

                <div class="group-card-top">
                  <span class="group-role"
                        title="<%= group.role %>">
                    <i class="bi bi-shield-check"></i>
                    <%= group.role %>
                  </span>

                  <span class="group-members">
                    <i class="bi bi-people"></i>
                    <%= group.member_count %>
                  </span>
                </div>

                <h3><%= group.name %></h3>

                <p class="group-description">
                  <%= group.description || 'Belum ada deskripsi kelompok.' %>
                </p>

                <div class="group-card-divider"></div>

                <div class="group-card-meta">
                  <i class="bi bi-list-check"></i>
                  <span><%= group.task_count %> tugas kelompok</span>
                </div>

                <a href="/groups/<%= group.id %>" class="group-open">
                  Buka Kelompok
                  <i class="bi bi-arrow-right"></i>
                </a>

              </article>
            <% }) %>
          </div>

        <% } %>
      </section>

    </div>
  </div>
</div>

<%- include('partials/foot') %>
