
<%- include('partials/head', { title: 'Profil Saya' }) %>

<style>
  .profile-page {
    --pf-primary: #4f46e5;
    --pf-primary-dark: #3730a3;
    --pf-text: #182033;
    --pf-muted: #64748b;
    --pf-border: #e8ebf3;
    --pf-surface: var(--bs-body-bg);
    max-width: 1060px;
    margin: 0 auto;
    color: var(--bs-body-color);
  }

  .profile-page * {
    box-sizing: border-box;
  }

  /* Page heading */
  .pf-page-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 18px;
    margin-bottom: 25px;
  }

  .pf-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 9px;
    color: var(--pf-primary);
    font-size: .76rem;
    font-weight: 800;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .pf-page-title {
    margin: 0 0 8px;
    color: var(--bs-emphasis-color);
    font-size: clamp(1.65rem, 4vw, 2.1rem);
    font-weight: 850;
    letter-spacing: -.045em;
  }

  .pf-page-description {
    margin: 0;
    color: var(--pf-muted);
    font-size: .94rem;
    line-height: 1.7;
  }

  /* Main profile card */
  .profile-card {
    overflow: hidden;
    border: 1px solid var(--pf-border);
    border-radius: 24px;
    background: var(--pf-surface);
    box-shadow: 0 14px 45px rgba(15, 23, 42, .055);
  }

  /* Decorative cover */
  .profile-cover {
    position: relative;
    isolation: isolate;
    height: 205px;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 16% 0%, rgba(255,255,255,.19), transparent 36%),
      radial-gradient(ellipse at 90% 100%, rgba(129,140,248,.48), transparent 43%),
      linear-gradient(120deg, #25205f 0%, #3730a3 34%, #4f46e5 67%, #818cf8 100%);
  }

  .profile-cover::before {
    content: "";
    position: absolute;
    z-index: -1;
    width: 300px;
    height: 300px;
    top: -190px;
    right: 14%;
    border: 1px solid rgba(255,255,255,.22);
    border-radius: 50%;
    box-shadow:
      0 0 0 28px rgba(255,255,255,.045),
      0 0 0 58px rgba(255,255,255,.035),
      0 0 0 90px rgba(255,255,255,.025);
  }

  .profile-cover::after {
    content: "";
    position: absolute;
    z-index: -1;
    width: 260px;
    height: 260px;
    right: -90px;
    bottom: -190px;
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 50%;
    box-shadow: 0 0 0 30px rgba(255,255,255,.04);
  }

  .pf-cover-label {
    position: absolute;
    top: 22px;
    left: 25px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    color: rgba(255,255,255,.93);
    background: rgba(255,255,255,.11);
    border: 1px solid rgba(255,255,255,.19);
    border-radius: 999px;
    font-size: .75rem;
    font-weight: 700;
    backdrop-filter: blur(10px);
  }

  .pf-cover-symbol {
    position: absolute;
    right: 8%;
    top: 24px;
    color: rgba(255,255,255,.15);
    font-size: 5.5rem;
    transform: rotate(-10deg);
  }

  /* Profile identity area */
  .profile-header-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    gap: 20px;
    margin-top: -58px;
    margin-bottom: 28px;
  }

  /* Avatar background: layered gradient */
  .profile-avatar {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex: 0 0 116px;
    align-items: center;
    justify-content: center;
    width: 116px;
    height: 116px;
    border: 5px solid var(--pf-surface);
    border-radius: 50%;
    background:
      radial-gradient(circle at 28% 19%, rgba(255,255,255,.52), transparent 34%),
      radial-gradient(circle at 82% 85%, rgba(129,140,248,.6), transparent 48%),
      linear-gradient(145deg, #818cf8 0%, #6366f1 38%, #4338ca 100%);
    color: #fff;
    font-size: 2.65rem;
    font-weight: 850;
    letter-spacing: -.055em;
    line-height: 1;
    text-shadow: 0 3px 10px rgba(30,27,75,.24);
    box-shadow:
      0 10px 25px rgba(49,46,129,.2),
      0 3px 8px rgba(15,23,42,.08);
    transition: transform .25s ease, box-shadow .25s ease;
  }

  .profile-avatar::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -29px;
    right: -24px;
    width: 82px;
    height: 82px;
    border: 1px solid rgba(255,255,255,.23);
    border-radius: 50%;
    box-shadow: 0 0 0 15px rgba(255,255,255,.055);
  }

  .profile-avatar::after {
    content: "";
    position: absolute;
    z-index: -1;
    left: -17px;
    bottom: -32px;
    width: 75px;
    height: 75px;
    border-radius: 50%;
    background: rgba(255,255,255,.1);
  }

  .profile-avatar:hover {
    transform: translateY(-3px);
    box-shadow:
      0 15px 30px rgba(49,46,129,.25),
      0 3px 8px rgba(15,23,42,.08);
  }

  .profile-info {
    min-width: 0;
    flex: 1;
    padding-bottom: 5px;
    overflow-wrap: anywhere;
  }

  .profile-info h2 {
    margin-bottom: 6px;
    color: var(--bs-emphasis-color);
    font-size: 1.45rem;
    font-weight: 850;
    letter-spacing: -.04em;
    overflow-wrap: anywhere;
  }

  .profile-info > p {
    margin-bottom: 13px;
    color: var(--pf-muted);
    font-size: .92rem;
    overflow-wrap: anywhere;
  }

  .pf-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pf-badges .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 8px 11px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: .73rem;
    font-weight: 750;
  }

  .pf-badges .text-bg-primary {
    color: #4338ca !important;
    background: #eef2ff !important;
    border-color: #e0e7ff;
  }

  .pf-badges .text-bg-success {
    color: #166534 !important;
    background: #dcfce7 !important;
    border-color: #bbf7d0;
  }

  .pf-badges .text-bg-secondary {
    color: #475569 !important;
    background: #f1f5f9 !important;
    border-color: #e2e8f0;
  }

  .pf-edit-wrap {
    flex-shrink: 0;
    padding-bottom: 5px;
  }

  .profile-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 10px 15px;
    border-radius: 12px;
    font-size: .83rem;
    font-weight: 750;
    text-decoration: none;
    transition: background .2s ease, color .2s ease,
                border-color .2s ease, transform .2s ease;
  }

  .profile-action.btn-outline-primary {
    color: var(--pf-primary);
    background: var(--pf-surface);
    border-color: #c7d2fe;
  }

  .profile-action.btn-outline-primary:hover {
    color: #fff;
    background: var(--pf-primary);
    border-color: var(--pf-primary);
    transform: translateY(-2px);
    box-shadow: 0 7px 16px rgba(79,70,229,.16);
  }

  /* Main card content */
  .pf-card-body {
    padding: 0 30px 30px;
  }

  .pf-divider {
    height: 1px;
    margin: 0 0 27px;
    background: var(--pf-border);
  }

  .pf-section {
    margin-bottom: 29px;
  }

  .pf-section:last-child {
    margin-bottom: 0;
  }

  .profile-section-title {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 17px;
    color: var(--bs-emphasis-color);
    font-size: 1rem;
    font-weight: 850;
    letter-spacing: -.02em;
  }

  .pf-section-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    border: 1px solid #e0e7ff;
    border-radius: 11px;
    background: #eef2ff;
    color: var(--pf-primary);
    font-size: 1rem;
  }

  /* Detail tiles */
  .profile-detail {
    position: relative;
    height: 100%;
    min-height: 106px;
    padding: 17px;
    border: 1px solid var(--pf-border);
    border-radius: 15px;
    background: var(--pf-surface);
    transition: border-color .2s ease, box-shadow .2s ease,
                transform .2s ease;
  }

  .profile-detail:hover {
    border-color: #c7d2fe;
    box-shadow: 0 7px 20px rgba(79,70,229,.055);
    transform: translateY(-2px);
  }

  .profile-label {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 11px;
    color: var(--pf-muted);
    font-size: .79rem;
    font-weight: 550;
  }

  .profile-label i {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    border-radius: 9px;
    background: #f1f3ff;
    color: var(--pf-primary);
    font-size: .95rem;
  }

  .profile-value {
    margin: 0;
    color: var(--bs-emphasis-color);
    font-size: .91rem;
    font-weight: 700;
    line-height: 1.65;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  /* Security note */
  .profile-note {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    padding: 20px 22px;
    border: 1px solid #e0e7ff !important;
    border-radius: 17px;
    background: #f8f9ff !important;
  }

  .pf-note-icon {
    display: flex;
    flex: 0 0 43px;
    align-items: center;
    justify-content: center;
    width: 43px;
    height: 43px;
    border: 1px solid #e0e7ff;
    border-radius: 13px;
    background: #eef2ff;
    color: var(--pf-primary);
    font-size: 1.2rem;
  }

  .profile-note h3 {
    margin: 1px 0 6px;
    color: #312e81;
    font-size: .91rem;
    font-weight: 850;
  }

  .profile-note p {
    color: #64748b;
    font-size: .84rem;
    line-height: 1.75;
  }

  /* Entrance animation */
  @keyframes pf-enter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pf-animate {
    animation: pf-enter .45s ease both;
  }

  /* Responsive */
  @media (max-width: 767.98px) {
    .profile-page {
      max-width: 100%;
    }

    .pf-page-heading {
      align-items: flex-start;
      margin-bottom: 20px;
    }

    .profile-cover {
      height: 165px;
    }

    .pf-cover-label {
      top: 16px;
      left: 17px;
    }

    .pf-cover-symbol {
      right: 4%;
      font-size: 4.3rem;
    }

    .profile-header-content {
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 13px;
      margin-top: -52px;
      margin-bottom: 24px;
    }

    .profile-avatar {
      flex-basis: 100px;
      width: 100px;
      height: 100px;
      font-size: 2.3rem;
    }

    .profile-info {
      flex-basis: calc(100% - 120px);
      padding-bottom: 3px;
    }

    .profile-info h2 {
      font-size: 1.2rem;
    }

    .pf-edit-wrap {
      width: 100%;
      padding: 0;
    }

    .pf-edit-wrap .profile-action {
      width: 100%;
    }

    .pf-card-body {
      padding: 0 20px 22px;
    }

    .profile-detail {
      min-height: 100px;
      padding: 15px;
    }

    .pf-divider {
      margin-bottom: 23px;
    }

    .pf-section {
      margin-bottom: 25px;
    }
  }

  @media (max-width: 420px) {
    .profile-cover {
      height: 140px;
    }

    .profile-header-content {
      margin-top: -44px;
      gap: 12px;
    }

    .profile-avatar {
      flex-basis: 84px;
      width: 84px;
      height: 84px;
      border-width: 4px;
      font-size: 2rem;
    }

    .profile-info {
      flex-basis: calc(100% - 96px);
    }

    .profile-info h2 {
      font-size: 1.08rem;
    }

    .profile-info > p {
      font-size: .81rem;
      margin-bottom: 10px;
    }

    .pf-badges {
      gap: 6px;
    }

    .pf-badges .badge {
      padding: 6px 8px;
      font-size: .68rem;
    }

    .pf-card-body {
      padding-right: 15px;
      padding-left: 15px;
    }

    .profile-detail {
      padding: 13px;
    }

    .profile-value {
      font-size: .85rem;
    }

    .profile-note {
      padding: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-animate {
      animation: none;
    }

    .profile-avatar,
    .profile-detail,
    .profile-action {
      transition: none;
    }
  }
</style>

<%
  const profileUser = typeof user !== 'undefined' && user
    ? user
    : (typeof currentUser !== 'undefined' && currentUser ? currentUser : {});

  const displayName = profileUser.name || 'Pengguna TaskFlow';
  const displayEmail = profileUser.email || 'Belum diisi';

  const userTypeLabels = {
    mahasiswa: 'Mahasiswa',
    siswa: 'Siswa'
  };

  const displayUserType = userTypeLabels[profileUser.user_type]
    || profileUser.user_type
    || 'Belum diisi';

  const displayInstitution = profileUser.institution || 'Belum diisi';
  const displayWhatsapp = profileUser.whatsapp || 'Belum diisi';
  const displayTimezone = profileUser.timezone || 'Asia/Jakarta';
  const displayRole = profileUser.role === 'admin'
    ? 'Administrator'
    : 'Pengguna';

  const isActive = Number(profileUser.is_active) === 1;
  const initial = String(displayName).trim().charAt(0).toUpperCase() || 'U';
%>

<div class="container py-4 py-lg-5 pf-animate">
  <div class="profile-page">

    <!-- Page heading -->
    <div class="pf-page-heading">
      <div>
        <div class="pf-eyebrow">
          <i class="bi bi-person-badge"></i>
          AKUN SAYA
        </div>
        <h1 class="pf-page-title">Profil Saya</h1>
        <p class="pf-page-description">
          Informasi pribadi dan detail akun TaskFlow milikmu.
        </p>
      </div>
    </div>

    <!-- Profile card -->
    <section class="card profile-card mb-4">

      <div class="profile-cover">
        <div class="pf-cover-label">
          <i class="bi bi-stars"></i>
          Profil Pengguna
        </div>
        <i class="bi bi-person-bounding-box pf-cover-symbol"
           aria-hidden="true"></i>
      </div>

      <div class="card-body pf-card-body">

        <!-- User identity -->
        <div class="profile-header-content">

          <div class="profile-avatar" aria-label="Inisial pengguna">
            <%= initial %>
          </div>

          <div class="profile-info">
            <h2><%= displayName %></h2>
            <p><i class="bi bi-envelope me-1"></i> <%= displayEmail %></p>

            <div class="pf-badges">
              <span class="badge rounded-pill text-bg-primary">
                <i class="bi bi-person-badge"></i>
                <%= displayRole %>
              </span>

              <span class="badge rounded-pill <%= isActive ? 'text-bg-success' : 'text-bg-secondary' %>">
                <i class="bi <%= isActive ? 'bi-check-circle-fill' : 'bi-pause-circle-fill' %>"></i>
                <%= isActive ? 'Akun Aktif' : 'Status Tidak Aktif' %>
              </span>
            </div>
          </div>

          <div class="pf-edit-wrap">
            <a href="/profile/edit" class="btn btn-outline-primary profile-action">
              <i class="bi bi-pencil-square"></i>
              Ubah Informasi
            </a>
          </div>

        </div>

        <div class="pf-divider"></div>

        <!-- Personal information -->
        <section class="pf-section">
          <h3 class="profile-section-title">
            <span class="pf-section-icon">
              <i class="bi bi-person-lines-fill"></i>
            </span>
            Informasi Pribadi
          </h3>

          <div class="row g-3">

            <div class="col-12 col-md-6">
              <div class="profile-detail">
                <div class="profile-label">
                  <i class="bi bi-person"></i>
                  Nama Lengkap
                </div>
                <p class="profile-value"><%= displayName %></p>
              </div>
            </div>

            <div class="col-12 col-md-6">
              <div class="profile-detail">
                <div class="profile-label">
                  <i class="bi bi-envelope"></i>
                  Alamat Email
                </div>
                <p class="profile-value"><%= displayEmail %></p>
              </div>
            </div>

            <div class="col-12 col-md-6">
              <div class="profile-detail">
                <div class="profile-label">
                  <i class="bi bi-mortarboard"></i>
                  Jenis Pengguna
                </div>
                <p class="profile-value"><%= displayUserType %></p>
              </div>
            </div>

            <div class="col-12 col-md-6">
              <div class="profile-detail">
                <div class="profile-label">
                  <i class="bi bi-building"></i>
                  Institusi / Sekolah / Kampus
                </div>
                <p class="profile-value"><%= displayInstitution %></p>
              </div>
            </div>

            <div class="col-12 col-md-6">
              <div class="profile-detail">
                <div class="profile-label">
                  <i class="bi bi-whatsapp"></i>
                  Nomor WhatsApp
                </div>
                <p class="profile-value"><%= displayWhatsapp %></p>
              </div>
            </div>

            <div class="col-12 col-md-6">
              <div class="profile-detail">
                <div class="profile-label">
                  <i class="bi bi-globe-asia-australia"></i>
                  Zona Waktu
                </div>
                <p class="profile-value"><%= displayTimezone %></p>
              </div>
            </div>

          </div>
        </section>

        <!-- Account information -->
        <section class="pf-section">
          <h3 class="profile-section-title">
            <span class="pf-section-icon">
              <i class="bi bi-shield-check"></i>
            </span>
            Informasi Akun
          </h3>

          <div class="row g-3">

            <div class="col-12 col-md-6">
              <div class="profile-detail">
                <div class="profile-label">
                  <i class="bi bi-shield-lock"></i>
                  Hak Akses
                </div>
                <p class="profile-value"><%= displayRole %></p>
              </div>
            </div>

            <% if (profileUser.created_at) { %>
              <div class="col-12 col-md-6">
                <div class="profile-detail">
                  <div class="profile-label">
                    <i class="bi bi-calendar-check"></i>
                    Tanggal Bergabung
                  </div>
                  <p class="profile-value">
                    <%= new Date(profileUser.created_at).toLocaleDateString('id-ID', {
                      day: 'numeric',
                      month: 'long',
                      year: 'numeric',
                      timeZone: 'Asia/Jakarta'
                    }) %>
                  </p>
                </div>
              </div>
            <% } %>

          </div>
        </section>

      </div>
    </section>

    <!-- Security note -->
    <div class="alert alert-light profile-note mb-0" role="note">
      <div class="pf-note-icon">
        <i class="bi bi-shield-lock"></i>
      </div>
      <div>
        <h3>Jaga keamanan akunmu</h3>
        <p class="mb-0">
          Pastikan informasi profil tetap benar dan jangan membagikan kata sandi
          kepada orang lain.
        </p>
      </div>
    </div>

  </div>
</div>

<%- include('partials/foot') %>
