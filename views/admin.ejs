<%- include('partials/head',{title:'Admin'}) %><div class="row g-3 mb-4"><% [['Pengguna',s.users],['Total tugas',s.total],['Belum selesai',s.open_],['Selesai',s.done],['Terlambat',s.late]].forEach(c=>{ %><div class="col-6 col-md"><div class="card"><div class="card-body"><div class="text-muted small"><%= c[0] %></div><div class="fs-3 fw-bold"><%= c[1]||0 %></div></div></div></div><% }) %></div>
<div class="card"><div class="card-header">Audit terbaru</div><ul class="list-group list-group-flush"><% logs.forEach(l=>{ %><li class="list-group-item small"><%= l.created_at %> · <b><%= l.action %></b> · <%= l.email %> · <%= l.detail %></li><% }) %></ul></div><%- include('partials/foot') %>
