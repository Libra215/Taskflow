
<%- include('partials/head', { title: 'Edit Profil' }) %>

<style>
  .edit-profile-page {
    --ep-primary: #4f46e5;
    --ep-primary-dark: #3730a3;
    --ep-border: #e7eaf2;
    --ep-muted: #64748b;
    max-width: 960px;
    margin: 0 auto;
    color: var(--bs-body-color);
  }

  .edit-profile-page * {
    box-sizing: border-box;
  }

  /* Heading */
  .ep-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 23px;
    color: var(--ep-muted);
    font-size: .86rem;
    font-weight: 650;
    text-decoration: none;
    transition: color .2s ease, gap .2s ease;
  }

  .ep-back:hover {
    gap: 12px;
    color: var(--ep-primary);
  }

  .edit-profile-heading {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 26px;
  }

  .edit-profile-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    flex: 0 0 58px;
    border: 1px solid #e0e7ff;
    border-radius: 17px;
    background: linear-gradient(145deg, #eef2ff, #e0e7ff);
    color: var(--ep-primary);
    font-size: 1.55rem;
    box-shadow: 0 5px 15px rgba(79,70,229,.07);
  }

  .ep-eyebrow {
    margin-bottom: 7px;
    color: var(--ep-primary);
    font-size: .74rem;
    font-weight: 800;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .ep-page-title {
    margin: 0 0 8px;
    color: var(--bs-emphasis-color);
    font-size: clamp(1.65rem, 4vw, 2.1rem);
    font-weight: 850;
    letter-spacing: -.045em;
  }

  .ep-page-description {
    max-width: 620px;
    margin: 0;
    color: var(--ep-muted);
    font-size: .92rem;
    line-height: 1.75;
  }

  /* Account summary */
  .edit-profile-summary {
    position: relative;
    overflow: hidden;
    padding: 23px;
    margin-bottom: 24px;
    border: 1px solid #e0e7ff;
    border-radius: 20px;
    background:
      radial-gradient(ellipse at 100% 0%, rgba(129,140,248,.13), transparent 40%),
      linear-gradient(120deg, #fbfbff, #f4f5ff);
  }

  .edit-profile-summary::after {
    content: "";
    position: absolute;
    top: -65px;
    right: -35px;
    width: 160px;
    height: 160px;
    border: 1px solid rgba(99,102,241,.1);
    border-radius: 50%;
    box-shadow: 0 0 0 22px rgba(99,102,241,.035);
    pointer-events: none;
  }

  .ep-summary-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  .edit-profile-avatar {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    flex: 0 0 64px;
    border: 3px solid rgba(255,255,255,.95);
    border-radius: 50%;
    background:
      radial-gradient(circle at 28% 18%, rgba(255,255,255,.5), transparent 35%),
      linear-gradient(145deg, #818cf8, #6366f1 45%, #3730a3);
    color: #fff;
    font-size: 1.55rem;
    font-weight: 850;
    letter-spacing: -.04em;
    text-shadow: 0 2px 7px rgba(30,27,75,.2);
    box-shadow: 0 7px 18px rgba(79,70,229,.22);
  }

  .edit-profile-avatar::after {
    content: "";
    position: absolute;
    z-index: -1;
    width: 45px;
    height: 45px;
    right: -18px;
    top: -18px;
    border: 1px solid rgba(255,255,255,.3);
    border-radius: 50%;
  }

  .ep-summary-info {
    min-width: 0;
    flex: 1;
  }

  .ep-summary-name {
    margin-bottom: 6px;
    color: #1e1b4b;
    font-size: 1.03rem;
    font-weight: 850;
    overflow-wrap: anywhere;
  }

  .ep-summary-line {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin-top: 5px;
    color: #64748b;
    font-size: .82rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .ep-summary-line i {
    margin-top: 3px;
    color: var(--ep-primary);
  }

  .ep-account-tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
    padding: 9px 12px;
    border: 1px solid #e0e7ff;
    border-radius: 999px;
    background: rgba(255,255,255,.8);
    color: #4338ca;
    font-size: .74rem;
    font-weight: 750;
  }

  /* Main form card */
  .edit-profile-card {
    overflow: hidden;
    border: 1px solid var(--ep-border);
    border-radius: 22px;
    background: var(--bs-body-bg);
    box-shadow: 0 12px 40px rgba(15,23,42,.05);
  }

  .ep-card-body {
    padding: 30px;
  }

  .ep-section {
    margin-bottom: 31px;
  }

  .ep-section:last-child {
    margin-bottom: 0;
  }

  .edit-profile-section-title {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 9px;
    color: var(--bs-emphasis-color);
    font-size: 1rem;
    font-weight: 850;
    letter-spacing: -.02em;
  }

  .ep-section-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 37px;
    height: 37px;
    flex: 0 0 37px;
    border: 1px solid #e0e7ff;
    border-radius: 11px;
    background: #eef2ff;
    color: var(--ep-primary);
    font-size: 1rem;
  }

  .edit-profile-section-description {
    margin: 0 0 23px 48px;
    color: var(--ep-muted);
    font-size: .84rem;
    line-height: 1.7;
  }

  .ep-divider {
    height: 1px;
    margin: 30px 0;
    border: 0;
    background: var(--ep-border);
    opacity: 1;
  }

  /* Form controls */
  .edit-profile-page .form-label {
    display: block;
    margin-bottom: 9px;
    color: var(--bs-emphasis-color);
    font-size: .85rem;
    font-weight: 750;
  }

  .edit-profile-page .form-control,
  .edit-profile-page .form-select {
    min-height: 48px;
    padding: 11px 14px;
    border: 1px solid #dce1eb;
    border-radius: 12px;
    background-color: var(--bs-body-bg);
    color: var(--bs-body-color);
    font-size: .9rem;
    box-shadow: none;
    transition: border-color .2s ease, box-shadow .2s ease;
  }

  .edit-profile-page .form-control::placeholder {
    color: #9aa4b5;
  }

  .edit-profile-page .form-control:focus,
  .edit-profile-page .form-select:focus {
    border-color: #818cf8;
    box-shadow: 0 0 0 4px rgba(99,102,241,.12);
    outline: none;
  }

  .edit-profile-page .form-control[readonly] {
    background: var(--bs-tertiary-bg);
    border-color: #e4e7ee;
    color: var(--ep-muted);
    cursor: default;
  }

  .edit-profile-page .input-group-text {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 47px;
    border: 1px solid #dce1eb;
    border-right: 0;
    border-radius: 12px 0 0 12px;
    background: var(--bs-tertiary-bg);
    color: var(--ep-primary);
    font-size: 1rem;
  }

  .edit-profile-page .input-group .form-control {
    min-width: 0;
    border-radius: 0 12px 12px 0;
  }

  .edit-profile-page .form-text {
    margin-top: 8px;
    color: var(--ep-muted);
    font-size: .77rem;
    line-height: 1.7;
  }

  .edit-profile-page .form-text i {
    color: var(--ep-primary);
  }

  .edit-profile-page .text-danger {
    font-weight: 800;
  }

  /* Helpful note */
  .edit-profile-tip {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    padding: 17px;
    margin-top: 28px;
    border: 1px solid #e0e7ff;
    border-radius: 15px;
    background: #f8f9ff;
    color: #4338ca;
  }

  .ep-tip-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    border-radius: 11px;
    background: #eef2ff;
    font-size: 1.05rem;
  }

  .ep-tip-title {
    margin-bottom: 5px;
    color: #312e81;
    font-size: .85rem;
    font-weight: 850;
  }

  .edit-profile-tip p {
    margin: 0;
    color: #64748b;
    font-size: .81rem;
    line-height: 1.75;
  }

  /* Footer actions */
  .edit-profile-actions {
    padding: 22px 30px;
    border-top: 1px solid var(--ep-border);
    background: var(--bs-tertiary-bg);
  }

  .ep-action-note {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ep-muted);
    font-size: .78rem;
    line-height: 1.6;
  }

  .ep-action-note i {
    color: var(--ep-primary);
    font-size: 1rem;
  }

  .edit-profile-page .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 11px 18px;
    border-radius: 12px;
    font-size: .85rem;
    font-weight: 750;
    transition: transform .2s ease, box-shadow .2s ease,
                background .2s ease;
  }

  .edit-profile-page .btn-primary {
    border-color: var(--ep-primary);
    background: var(--ep-primary);
    box-shadow: 0 5px 13px rgba(79,70,229,.15);
  }

  .edit-profile-page .btn-primary:hover {
    border-color: var(--ep-primary-dark);
    background: var(--ep-primary-dark);
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(79,70,229,.2);
  }

  .edit-profile-page .btn-outline-secondary {
    border-color: #d8deea;
    background: var(--bs-body-bg);
    color: var(--bs-secondary-color);
  }

  .edit-profile-page .btn-outline-secondary:hover {
    background: var(--bs-tertiary-bg);
    transform: translateY(-1px);
  }

  /* Responsive */
  @media (max-width: 767.98px) {
    .edit-profile-heading {
      gap: 13px;
    }

    .edit-profile-icon {
      width: 49px;
      height: 49px;
      flex-basis: 49px;
      border-radius: 14px;
      font-size: 1.3rem;
    }

    .edit-profile-summary {
      padding: 18px;
      border-radius: 17px;
    }

    .ep-account-tag {
      display: none;
    }

    .ep-card-body {
      padding: 23px 20px;
    }

    .edit-profile-section-description {
      margin-left: 0;
      margin-bottom: 20px;
    }

    .edit-profile-actions {
      padding: 20px;
    }

    .ep-action-note {
      align-items: flex-start;
    }
  }

  @media (max-width: 575.98px) {
    .ep-back {
      margin-bottom: 19px;
    }

    .edit-profile-heading {
      margin-bottom: 21px;
    }

    .edit-profile-summary {
      padding: 15px;
      margin-bottom: 18px;
    }

    .ep-summary-content {
      align-items: flex-start;
      gap: 12px;
    }

    .edit-profile-avatar {
      width: 52px;
      height: 52px;
      flex-basis: 52px;
      font-size: 1.3rem;
    }

    .ep-summary-name {
      font-size: .93rem;
    }

    .ep-summary-line {
      font-size: .76rem;
    }

    .edit-profile-card {
      border-radius: 18px;
    }

    .ep-card-body {
      padding: 20px 16px;
    }

    .ep-divider {
      margin: 24px 0;
    }

    .ep-section {
      margin-bottom: 25px;
    }

    .edit-profile-page .form-control,
    .edit-profile-page .form-select {
      min-height: 46px;
      font-size: .87rem;
    }

    .edit-profile-actions {
      padding: 17px 16px;
    }

    .edit-profile-actions .ep-action-buttons,
    .edit-profile-actions .ep-action-buttons .btn {
      width: 100%;
    }

    .edit-profile-actions .ep-action-buttons {
      display: flex;
      flex-direction: column;
    }

    .edit-profile-actions .ep-action-buttons .btn {
      min-height: 47px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edit-profile-page *,
    .ep-back {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<%
  const profileUser = typeof user !== 'undefined' && user ? user : {};
  const profileName = profileUser.name || '';
  const profileEmail = profileUser.email || '';
  const profileInstitution = profileUser.institution || '';
  const profileWhatsapp = profileUser.whatsapp || '';
  const profileTimezone = profileUser.timezone || 'Asia/Jakarta';

  const profileTypeLabels = {
    mahasiswa: 'Mahasiswa',
    siswa: 'Siswa'
  };

  const profileType = profileTypeLabels[profileUser.user_type]
    || profileUser.user_type
    || 'Belum ditentukan';

  const profileInitial = profileName.trim().charAt(0).toUpperCase() || 'U';
%>

<div class="container py-4 py-lg-5">
  <div class="edit-profile-page">

    <!-- Back navigation -->
    <a href="/profile" class="ep-back">
      <i class="bi bi-arrow-left"></i>
      Kembali ke profil
    </a>

    <!-- Page heading -->
    <div class="edit-profile-heading">
      <div class="edit-profile-icon">
        <i class="bi bi-person-gear"></i>
      </div>

      <div>
        <div class="ep-eyebrow">Pengaturan akun</div>
        <h1 class="ep-page-title">Edit Profil</h1>
        <p class="ep-page-description">
          Perbarui informasi akunmu agar tetap akurat dan mudah dikenali
          di TaskFlow.
        </p>
      </div>
    </div>

    <!-- Account summary -->
    <div class="edit-profile-summary">
      <div class="ep-summary-content">

        <div class="edit-profile-avatar" aria-label="Inisial pengguna">
          <%= profileInitial %>
        </div>

        <div class="ep-summary-info">
          <div class="ep-summary-name">
            <%= profileName || 'Pengguna TaskFlow' %>
          </div>

          <div class="ep-summary-line">
            <i class="bi bi-envelope"></i>
            <span><%= profileEmail || 'Email belum tersedia' %></span>
          </div>

          <div class="ep-summary-line">
            <i class="bi bi-mortarboard"></i>
            <span><%= profileType %></span>
          </div>
        </div>

        <span class="ep-account-tag">
          <i class="bi bi-shield-check"></i>
          Akun Saya
        </span>

      </div>
    </div>

    <!-- Main form -->
    <form action="/profile/edit" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrf %>">

      <div class="card edit-profile-card">
        <div class="ep-card-body">

          <!-- Personal information -->
          <section class="ep-section">
            <h2 class="edit-profile-section-title">
              <span class="ep-section-icon">
                <i class="bi bi-person-lines-fill"></i>
              </span>
              Informasi Pribadi
            </h2>

            <p class="edit-profile-section-description">
              Gunakan nama yang mudah dikenali dan informasi yang benar.
            </p>

            <div class="row g-4">

              <!-- Full name -->
              <div class="col-12">
                <label for="name" class="form-label">
                  Nama Lengkap <span class="text-danger">*</span>
                </label>

                <input
                  type="text"
                  class="form-control"
                  id="name"
                  name="name"
                  value="<%= profileName %>"
                  minlength="2"
                  maxlength="100"
                  autocomplete="name"
                  placeholder="Masukkan nama lengkap"
                  required
                >

                <div class="form-text">
                  Nama ini akan digunakan untuk mengenali akunmu di TaskFlow.
                </div>
              </div>

              <!-- Email -->
              <div class="col-12">
                <label for="email" class="form-label">
                  Alamat Email
                </label>

                <div class="input-group">
                  <span class="input-group-text">
                    <i class="bi bi-envelope"></i>
                  </span>

                  <input
                    type="email"
                    class="form-control"
                    id="email"
                    value="<%= profileEmail %>"
                    autocomplete="email"
                    readonly
                    aria-describedby="emailHelp"
                  >
                </div>

                <div id="emailHelp" class="form-text">
                  <i class="bi bi-info-circle me-1"></i>
                  Email ditampilkan sebagai informasi akun dan tidak dapat
                  diubah dari formulir ini.
                </div>
              </div>

              <!-- Institution -->
              <div class="col-12">
                <label for="institution" class="form-label">
                  Institusi / Sekolah / Kampus
                </label>

                <div class="input-group">
                  <span class="input-group-text">
                    <i class="bi bi-building"></i>
                  </span>

                  <input
                    type="text"
                    class="form-control"
                    id="institution"
                    name="institution"
                    value="<%= profileInstitution %>"
                    maxlength="150"
                    autocomplete="organization"
                    placeholder="Masukkan nama sekolah atau kampus"
                  >
                </div>

                <div class="form-text">
                  Contoh: nama sekolah, universitas, atau institusi tempatmu belajar.
                </div>
              </div>

              <!-- WhatsApp -->
              <div class="col-12">
                <label for="whatsapp" class="form-label">
                  Nomor WhatsApp
                </label>

                <div class="input-group">
                  <span class="input-group-text">
                    <i class="bi bi-whatsapp"></i>
                  </span>

                  <input
                    type="tel"
                    class="form-control"
                    id="whatsapp"
                    name="whatsapp"
                    value="<%= profileWhatsapp %>"
                    maxlength="25"
                    autocomplete="tel"
                    inputmode="tel"
                    placeholder="Contoh: 081234567890"
                  >
                </div>

                <div class="form-text">
                  Masukkan nomor WhatsApp yang aktif.
                </div>
              </div>

            </div>
          </section>

          <hr class="ep-divider">

          <!-- Preferences -->
          <section class="ep-section">
            <h2 class="edit-profile-section-title">
              <span class="ep-section-icon">
                <i class="bi bi-sliders"></i>
              </span>
              Preferensi Akun
            </h2>

            <p class="edit-profile-section-description">
              Atur zona waktu untuk menyesuaikan jadwal dan tenggat tugas.
            </p>

            <div class="row g-4">

              <!-- Timezone -->
              <div class="col-12 col-md-7">
                <label for="timezone" class="form-label">
                  Zona Waktu
                </label>

                <select class="form-select" id="timezone" name="timezone">
                  <option
                    value="Asia/Jakarta"
                    <%= profileTimezone === 'Asia/Jakarta' ? 'selected' : '' %>
                  >
                    WIB — Jakarta
                  </option>

                  <option
                    value="Asia/Makassar"
                    <%= profileTimezone === 'Asia/Makassar' ? 'selected' : '' %>
                  >
                    WITA — Makassar
                  </option>

                  <option
                    value="Asia/Jayapura"
                    <%= profileTimezone === 'Asia/Jayapura' ? 'selected' : '' %>
                  >
                    WIT — Jayapura
                  </option>
                </select>

                <div class="form-text">
                  Pilih zona waktu sesuai lokasi tempatmu beraktivitas.
                </div>
              </div>

              <!-- User type -->
              <div class="col-12 col-md-5">
                <label for="user_type_display" class="form-label">
                  Jenis Pengguna
                </label>

                <input
                  type="text"
                  class="form-control"
                  id="user_type_display"
                  value="<%= profileType %>"
                  readonly
                >

                <div class="form-text">
                  Jenis pengguna tidak diubah melalui halaman ini.
                </div>
              </div>

            </div>
          </section>

          <!-- Reminder -->
          <div class="edit-profile-tip" role="note">
            <div class="ep-tip-icon">
              <i class="bi bi-lightbulb"></i>
            </div>

            <div>
              <div class="ep-tip-title">Sebelum menyimpan</div>
              <p>
                Periksa kembali informasi yang kamu masukkan. Data akan
                diperbarui setelah server memvalidasi dan menyimpan formulir.
              </p>
            </div>
          </div>

        </div>

        <!-- Action footer -->
        <div class="edit-profile-actions">
          <div class="d-flex flex-column flex-sm-row
                      justify-content-between align-items-sm-center gap-3">

            <p class="ep-action-note mb-0">
              <i class="bi bi-shield-lock"></i>
              <span>Jaga kerahasiaan informasi akunmu.</span>
            </p>

            <div class="ep-action-buttons d-flex flex-column flex-sm-row gap-2">
              <a href="/profile" class="btn btn-outline-secondary px-4">
                Batal
              </a>

              <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check2-circle me-2"></i>
                Simpan Perubahan
              </button>
            </div>

          </div>
        </div>

      </div>
    </form>

  </div>
</div>

<%- include('partials/foot') %>
