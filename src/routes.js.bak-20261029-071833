    limits: { fileSize: MAX, files: 1 },
    fileFilter: (q_, f, cb) => cb(null, /\.(pdf|docx?|xlsx?|pptx?|jpe?g|png)$/i.test(f.originalname))
});

const SIG = { pdf: [0x25, 0x50, 0x44, 0x46], png: [0x89, 0x50, 0x4e, 0x47], jpg: [0xff, 0xd8, 0xff], jpeg: [0xff, 0xd8, 0xff], docx: [0x50, 0x4b], xlsx: [0x50, 0x4b], pptx: [0x50, 0x4b], doc: [0xd0, 0xcf], xls: [0xd0, 0xcf], ppt: [0xd0, 0xcf] };
const sigOk = (f) => { const e = path.extname(f.originalname).slice(1).toLowerCase(), b = Buffer.alloc(4), fd = fs.openSync(f.path, 'r'); fs.readSync(fd, b, 0, 4, 0); fs.closeSync(fd); return SIG[e]?.every((x, i) => b[i] === x); };

async function saveTask(req, res, id) {
    const s = taskSchema.safeParse(req.body);

    if (req.file && !sigOk(req.file)) {
        fs.unlink(req.file.path, () => {});
        flash(req, 'danger', 'Isi file tidak sesuai ekstensi');
        return back(req, res);
    }

    if (!s.success) {
        if (req.file) fs.unlink(req.file.path, () => {});
        flash(req, 'danger', 'Data tugas tidak valid');
        return back(req, res);
    }

    const d = s.data;
    const userId = req.session.user.id;

    // Ambil status lama sebelum melakukan UPDATE.
    let previousTask = null;

    if (id) {
        const rows = await q(
            'SELECT id, title, status FROM tasks WHERE id = ? AND user_id = ?',
            [id, userId]
        );

        previousTask = rows[0] || null;

        if (!previousTask) {
            if (req.file) fs.unlink(req.file.path, () => {});

            return res.status(404).render('error', {
                code: 404,
                msg: 'Tugas tidak ditemukan'
            });
        }
    }

    const v = [
        d.title,
        d.description || null,
        d.subject || null,
        d.teacher || null,
        d.category_id || null,
        d.deadline.replace('T', ' ') + ':00',
        d.priority,
        d.status,
        d.notes || null,
        d.status === 'selesai'
            ? new Date().toISOString().slice(0, 19).replace('T', ' ')
            : null
    ];

    let isNewTask = false;

