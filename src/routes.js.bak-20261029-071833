    const inviteCode = require('crypto')
        .randomBytes(18)
        .toString('hex');

    const userId = req.session.user.id;
    const conn = await require('./db').pool.promise().getConnection();

    try {
        await conn.beginTransaction();

        const [created] = await conn.execute(`
            INSERT INTO task_groups
            (owner_id, name, description, invite_code)
            VALUES (?, ?, ?, ?)
        `, [userId, name, description || null, inviteCode]);

        await conn.execute(`
            INSERT INTO task_group_members
            (group_id, user_id, role)
            VALUES (?, ?, 'ketua')
        `, [created.insertId, userId]);

        await conn.commit();

        flash(req, 'success', 'Kelompok berhasil dibuat');
        res.redirect('/groups/' + created.insertId);
    } catch (err) {
        await conn.rollback();
        throw err;
    } finally {
        conn.release();
    }
}));


