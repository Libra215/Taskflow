        id = (
            await q(
                `INSERT INTO tasks
                    (title, description, subject, teacher, category_id,
                     deadline, priority, status, notes, completed_at, user_id)
                 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
                [...v, userId]
            )
        ).insertId;

        isNewTask = true;
    }

    // Pertahankan proses lampiran yang sudah ada.
    if (req.file) {
        const old = await q(
            'SELECT stored_name FROM task_attachments WHERE task_id=?',
            [id]
        );

        old.forEach(o => {
            fs.unlink(path.join(UP, o.stored_name), () => {});
        });

        await q(
            'DELETE FROM task_attachments WHERE task_id=?',
            [id]
        );

        await q(
            `INSERT INTO task_attachments
                (task_id, original_name, stored_name, mime, size_bytes)
             VALUES (?, ?, ?, ?, ?)`,
            [
                id,
                Buffer.from(req.file.originalname, 'latin1')
                    .toString('utf8')
                    .slice(0, 255),
                req.file.filename,
                req.file.mimetype,
                req.file.size
            ]
        );
    }

    // Integrasi notifikasi WhatsApp.
    try {
        const { queueNotification } = require('./notifications');

        // Kirim notifikasi hanya ketika status baru berubah menjadi selesai.
        const becameCompleted =
            d.status === 'selesai' &&
            previousTask &&
            previousTask.status !== 'selesai';

        if (becameCompleted) {
            queueNotification(
                userId,
                `task-completed:${id}`,
                `✅ *Tugas Selesai — TaskFlow*\n\n` +
                `Tugas kamu telah ditandai selesai.\n\n` +
                `📌 Tugas: ${d.title}\n` +
                `🎉 Bagus, satu tugas sudah tuntas!`
            );
        }

        // Tugas baru yang langsung dibuat dengan status selesai.
        if (isNewTask && d.status === 'selesai') {
            queueNotification(
                userId,
                `task-completed:${id}`,
                `✅ *Tugas Selesai — TaskFlow*\n\n` +
                `📌 Tugas: ${d.title}\n` +
                `Tugas baru ini sudah berstatus selesai.`
            );
        }
    } catch (error) {
        // Kegagalan notifikasi tidak membatalkan penyimpanan tugas.
        console.error(
            '[TaskFlow] Gagal menjadwalkan notifikasi WhatsApp:',
            error.message
        );
    }

    flash(req, 'success', 'Tugas disimpan');
    return res.redirect('/tasks/' + id);
}

