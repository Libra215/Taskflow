/* Tahap 1: validasi formulir, simpan data sementara, kirim OTP */
r.post('/register', limiter, otpLimiter, wrap(async (req, res) => {
    if (!safeEqual(
        String(req.body._csrf || ''),
        String(req.session.registerCsrf || '')
    )) {
        flash(req, 'danger', 'Sesi formulir tidak valid. Silakan coba lagi.');
        return res.redirect('/register');
    }

    delete req.session.registerCsrf;

    const schema = z.object({
        name: z.string().trim().min(2).max(100),
        email: z.string().trim().toLowerCase().email().max(190),
        password: z.string().min(8).max(72),
        whatsapp: z.string().trim().min(8).max(25),
        user_type: z.enum(['mahasiswa', 'siswa']),
        institution: z.string().trim().max(150).optional()
    });

    const parsed = schema.safeParse(req.body);

    if (!parsed.success) {
        flash(
            req,
            'danger',
            'Data tidak valid. Periksa kembali formulir dan password minimal 8 karakter.'
        );
        return res.redirect('/register');
    }

    const d = parsed.data;

    let phone;

    try {
        phone = normalizePhone(d.whatsapp);
    } catch {
        flash(
            req,
            'danger',
            'Format nomor WhatsApp tidak valid. Contoh: 081234567890.'
        );
        return res.redirect('/register');
    }

    if (!process.env.OTP_PEPPER || process.env.OTP_PEPPER.length < 32) {
        flash(req, 'danger', 'Konfigurasi keamanan OTP belum tersedia.');
        return res.redirect('/register');
    }

    // Pastikan email dan nomor belum digunakan.
    const [existing] = await q(
        `SELECT id
         FROM users
         WHERE email = ? OR whatsapp = ?
         LIMIT 1`,
        [d.email, phone]
    );

    if (existing) {
        flash(
            req,
            'danger',
            'Email atau nomor WhatsApp sudah digunakan.'
        );
        return res.redirect('/register');
    }

    // Hapus data registrasi sementara yang sudah kedaluwarsa.
    await q(
        'DELETE FROM pending_registrations WHERE expires_at <= NOW()'
    );

    // Hapus proses registrasi lama untuk email/nomor yang sama.
    await q(
        `DELETE FROM pending_registrations
         WHERE email = ? OR whatsapp = ?`,
        [d.email, phone]
    );

    const id = crypto.randomUUID();
    const code = String(
        crypto.randomInt(0, 1000000)
    ).padStart(6, '0');

    const passwordHash = await bcrypt.hash(d.password, 12);
    const hashedOtp = otpHash(id, code);

    await q(
        `INSERT INTO pending_registrations
            (
                id, name, email, password_hash,
                user_type, institution, whatsapp,
                otp_hash, attempts, expires_at, last_sent_at
            )
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, 0,
                 DATE_ADD(NOW(), INTERVAL 5 MINUTE), NOW())`,
        [
            id,
            d.name,
            d.email,
            passwordHash,
            d.user_type,
            d.institution || null,
            phone,
            hashedOtp
        ]
    );

    req.session.pendingRegistrationId = id;

    const message =
        `🔐 *Kode OTP TaskFlow*\n\n` +
        `Kode verifikasi kamu: *${code}*\n\n` +
        `Kode berlaku selama 5 menit dan hanya dapat digunakan sekali.\n` +
        `Jangan bagikan kode ini kepada siapa pun.\n\n` +
        `Jika kamu tidak melakukan registrasi, abaikan pesan ini.`;

    try {
        const result = await sendWhatsApp(phone, message);

        if (!['SUCCESS', 'PENDING'].includes(result.status)) {
            throw new Error('Sidobe melaporkan pengiriman OTP gagal.');
        }

        flash(
            req,
            result.status === 'SUCCESS' ? 'success' : 'warning',
            result.status === 'SUCCESS'
                ? 'OTP telah dikirim. Periksa WhatsApp kamu.'
                : 'Permintaan OTP sedang diproses. Periksa WhatsApp kamu.'
        );

        return res.redirect('/register/verify');
    } catch (error) {
        console.error('[OTP] Pengiriman gagal:', error.message);

        // Timeout/koneksi terputus berarti pesan mungkin sudah terkirim.
        // Pertahankan OTP agar tidak langsung membuat kode berbeda.
        if (error.uncertain === true) {
            flash(
                req,
                'warning',
                'Status pengiriman belum diketahui. Periksa WhatsApp sebelum meminta kode baru.'
            );

            return res.redirect('/register/verify');
        }

        await q(
            'DELETE FROM pending_registrations WHERE id = ?',
            [id]
        );

        delete req.session.pendingRegistrationId;

        flash(
            req,
            'danger',
            'OTP gagal dikirim. Silakan periksa nomor WhatsApp dan coba lagi.'
        );

        return res.redirect('/register');
    }
}));


