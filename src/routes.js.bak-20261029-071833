r.get('/register/verify', wrap(async (req, res) => {
    const id = req.session.pendingRegistrationId;

    if (!id) {
        flash(req, 'danger', 'Silakan mulai registrasi terlebih dahulu.');
        return res.redirect('/register');
    }

    const [pending] = await q(
        `SELECT id, whatsapp, expires_at,
                (expires_at <= NOW()) AS expired
         FROM pending_registrations
         WHERE id = ?`,
        [id]
    );

    if (!pending) {
        delete req.session.pendingRegistrationId;
        flash(req, 'danger', 'Data registrasi tidak ditemukan. Silakan ulangi.');
        return res.redirect('/register');
    }

    if (Number(pending.expired) === 1) {
        await q('DELETE FROM pending_registrations WHERE id = ?', [id]);
        delete req.session.pendingRegistrationId;

        flash(req, 'danger', 'OTP sudah kedaluwarsa. Silakan registrasi ulang.');
        return res.redirect('/register');
    }

    req.session.verifyCsrf = crypto.randomBytes(32).toString('hex');

    res.render('register_verify', {
        flash: takeFlash(req),
        csrfToken: req.session.verifyCsrf,
        whatsapp: maskPhone(pending.whatsapp)
    });
}));


/* Tahap 3: verifikasi kode dan baru membuat akun */
r.post('/register/verify', otpLimiter, wrap(async (req, res) => {
    if (!safeEqual(
        String(req.body._csrf || ''),
        String(req.session.verifyCsrf || '')
    )) {
        flash(req, 'danger', 'Sesi verifikasi tidak valid. Muat ulang halaman.');
        return res.redirect('/register/verify');
    }

    delete req.session.verifyCsrf;

    const id = req.session.pendingRegistrationId;

    if (!id) {
        flash(req, 'danger', 'Sesi registrasi berakhir. Silakan mulai lagi.');
        return res.redirect('/register');
    }

    const code = String(req.body.otp || '').trim();

    if (!/^\d{6}$/.test(code)) {
        flash(req, 'danger', 'Masukkan kode OTP 6 digit.');
        return res.redirect('/register/verify');
    }

    const [pending] = await q(
        `SELECT *
         FROM pending_registrations
         WHERE id = ? AND expires_at > NOW()`,
        [id]
    );

    if (!pending) {
        await q('DELETE FROM pending_registrations WHERE id = ?', [id]);
        delete req.session.pendingRegistrationId;

        flash(req, 'danger', 'OTP sudah kedaluwarsa. Silakan registrasi ulang.');
        return res.redirect('/register');
    }

    if (Number(pending.attempts) >= 5) {
        await q('DELETE FROM pending_registrations WHERE id = ?', [id]);
        delete req.session.pendingRegistrationId;

        flash(req, 'danger', 'Batas percobaan OTP tercapai. Silakan registrasi ulang.');
        return res.redirect('/register');
    }

    const submittedHash = otpHash(id, code);

    if (!safeEqual(submittedHash, pending.otp_hash)) {
        const nextAttempts = Number(pending.attempts) + 1;

        if (nextAttempts >= 5) {
            await q('DELETE FROM pending_registrations WHERE id = ?', [id]);
            delete req.session.pendingRegistrationId;

            flash(req, 'danger', 'Batas percobaan OTP tercapai. Silakan registrasi ulang.');
            return res.redirect('/register');
        }

        await q(
            'UPDATE pending_registrations SET attempts = ? WHERE id = ?',
            [nextAttempts, id]
        );

        flash(
            req,
            'danger',
            `OTP salah. Sisa percobaan: ${5 - nextAttempts}.`
        );

        return res.redirect('/register/verify');
    }

    // Periksa kembali sebelum membuat akun.
    const [existing] = await q(
        `SELECT id
         FROM users
         WHERE email = ? OR whatsapp = ?
         LIMIT 1`,
        [pending.email, pending.whatsapp]
    );

    if (existing) {
        await q('DELETE FROM pending_registrations WHERE id = ?', [id]);
        delete req.session.pendingRegistrationId;

        flash(req, 'danger', 'Email atau nomor WhatsApp sudah digunakan.');
        return res.redirect('/register');
    }

    // Akun baru baru dibuat setelah OTP benar.
    await q(
        `INSERT INTO users
            (
                name, email, password_hash,
                user_type, institution, whatsapp,
                role, is_active
            )
         VALUES (?, ?, ?, ?, ?, ?, 'user', 1)`,
        [
            pending.name,
            pending.email,
            pending.password_hash,
            pending.user_type,
            pending.institution,
            pending.whatsapp
        ]
    );

    await q(
        'DELETE FROM pending_registrations WHERE id = ?',
        [id]
    );

    delete req.session.pendingRegistrationId;

    flash(
        req,
        'success',
        'Registrasi dan verifikasi WhatsApp berhasil. Silakan login.'
    );

    return res.redirect('/login');
}));


/* Tahap 4: kirim ulang OTP dengan jeda 60 detik */
r.post('/register/resend-otp', otpLimiter, wrap(async (req, res) => {
    if (!safeEqual(
        String(req.body._csrf || ''),
        String(req.session.verifyCsrf || '')
    )) {
        flash(req, 'danger', 'Sesi verifikasi tidak valid. Muat ulang halaman.');
        return res.redirect('/register/verify');
    }

    delete req.session.verifyCsrf;

    const id = req.session.pendingRegistrationId;

    if (!id) {
        flash(req, 'danger', 'Sesi registrasi berakhir. Silakan mulai lagi.');
        return res.redirect('/register');
    }

    const [pending] = await q(
        `SELECT *
         FROM pending_registrations
         WHERE id = ? AND expires_at > NOW()`,
        [id]
    );

    if (!pending) {
        await q('DELETE FROM pending_registrations WHERE id = ?', [id]);
        delete req.session.pendingRegistrationId;

        flash(req, 'danger', 'Data OTP kedaluwarsa. Silakan registrasi ulang.');
        return res.redirect('/register');
    }

    const [cooldown] = await q(
        `SELECT id
         FROM pending_registrations
         WHERE id = ?
           AND last_sent_at > DATE_SUB(NOW(), INTERVAL 60 SECOND)`,
        [id]
    );

    if (cooldown) {
        flash(req, 'warning', 'Tunggu 60 detik sebelum meminta OTP lagi.');
        return res.redirect('/register/verify');
    }

    const code = String(
        crypto.randomInt(0, 1000000)
    ).padStart(6, '0');

    await q(
        `UPDATE pending_registrations
         SET otp_hash = ?,
             attempts = 0,
             expires_at = DATE_ADD(NOW(), INTERVAL 5 MINUTE),
             last_sent_at = NOW()
         WHERE id = ?`,
        [otpHash(id, code), id]
    );

    const message =
        `🔐 *Kode OTP TaskFlow*\n\n` +
        `Kode verifikasi baru kamu: *${code}*\n\n` +
        `Kode berlaku selama 5 menit.\n` +
        `Jangan bagikan kode ini kepada siapa pun.`;

    try {
        const result = await sendWhatsApp(pending.whatsapp, message);

        if (!['SUCCESS', 'PENDING'].includes(result.status)) {
            throw new Error('Sidobe melaporkan pengiriman OTP gagal.');
        }

        flash(
            req,
            result.status === 'SUCCESS' ? 'success' : 'warning',
            result.status === 'SUCCESS'
                ? 'OTP baru telah dikirim.'
                : 'Permintaan OTP baru sedang diproses.'
        );
    } catch (error) {
        console.error('[OTP] Pengiriman ulang gagal:', error.message);

        flash(
            req,
            'danger',
            'Pengiriman ulang belum dapat dipastikan. Tunggu sebelum mencoba lagi.'
        );
    }

    return res.redirect('/register/verify');
}));


