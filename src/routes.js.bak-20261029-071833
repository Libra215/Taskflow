        const x = await q(
            `UPDATE tasks
             SET title=?, description=?, subject=?, teacher=?,
                 category_id=?, deadline=?, priority=?, status=?,
                 notes=?, completed_at=?
             WHERE id=? AND user_id=?`,
            [...v, id, userId]
        );

        if (!x.affectedRows) {
            if (req.file) fs.unlink(req.file.path, () => {});

            return res.status(404).render('error', {
                code: 404,
                msg: 'Tugas tidak ditemukan'
            });
        }
